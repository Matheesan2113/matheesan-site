---
import SiteLayout from '../layouts/site.astro';
import PageHeader from '../components/PageHeader.astro';
import About from '../components/About.astro';
import Life from '../components/Life.astro';
import VisualStudies from '../components/VisualStudies.astro';
---

<SiteLayout
  title="About — Matheesan"
  description="About Matheesan Manokaran: Tamil-Canadian engineer, DJ, gamer, homelab operator and competitor at heart. The person behind the site."
  theme="about"
>
  <PageHeader
    crumb="about"
    title="The longer version."
    channel="ch.05 / self"
    glyph="月"
    deck="Engineer, DJ, gamer, Tamil-Canadian. Born in Toronto, raised in Markham. This is the part that doesn’t fit in a headline — music, games, family, the lab, and the through-line between them."
  />

  <About headless />
  <Life />
  <VisualStudies />
</SiteLayout>

<style is:global>
  #about { padding-top: 2.5rem; padding-bottom: 4rem; }
  #life { padding-top: 4rem; }
</style>
