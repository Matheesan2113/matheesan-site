---
import Layout from '../layouts/layout.astro';
import '../styles/drop.css';
import drop from '../data/drop.json';

const config = JSON.stringify({ endpoint: drop.endpoint ?? '', ...(drop.oidc ?? {}) });
const dropConnect = [
  drop.endpoint ? new URL(drop.endpoint).origin : '',
  drop.oidc?.token ? new URL(drop.oidc.token).origin : '',
  'https://s3.ca-central-1.amazonaws.com',
  'https://*.s3.ca-central-1.amazonaws.com',
].filter(Boolean);
---

<Layout
  mainId="drop"
  title="Drop — Matheesan"
  description="Private drop box." noindex
  csp={{ connect: dropConnect }}
>
  <main id="drop" data-config={config}>
    <section>
      <div class="container">
        <p class="section-label"><a href="/">matheesan.ca</a> / drop</p>
        <h1 class="section-title">Drop <em>box</em></h1>

        <div id="signin" class="drop-panel">
          <div class="drop-label">private</div>
          <p class="drop-lead">Sign in with your homelab account to open the inbox.</p>
          <button id="signin-btn" type="button" class="drop-btn">Sign in</button>
          <p id="signin-msg" class="drop-msg" role="status"></p>
        </div>

        <div id="unlocked" hidden>
          <div class="drop-grid">
            <div class="drop-panel">
              <div class="drop-label">files</div>
              <label id="dropzone" class="dropzone">
                <input id="file-input" type="file" multiple hidden />
                <span class="dropzone-title">Drop files here</span>
                <span class="dropzone-sub">or click to choose · up to 250 MB each</span>
              </label>
              <ul id="uploads" class="drop-uploads"></ul>
            </div>

            <form id="note-form" class="drop-panel">
              <label class="drop-label" for="note">note</label>
              <textarea id="note" class="drop-input drop-note" rows="7" placeholder="Links, snippets, reminders…"></textarea>
              <div class="drop-row drop-row-end">
                <span id="note-msg" class="drop-msg" role="status"></span>
                <button type="submit" class="drop-btn">Send note</button>
              </div>
            </form>
          </div>

          <div class="drop-panel">
            <div class="drop-row drop-row-between">
              <div class="drop-label">inbox · kept 30 days · copied to the private archive</div>
              <div class="drop-row">
                <button id="refresh" type="button" class="drop-link">refresh</button>
                <button id="signout" type="button" class="drop-link">sign out</button>
              </div>
            </div>
            <ul id="inbox" class="drop-inbox"></ul>
            <p id="inbox-msg" class="drop-msg" role="status"></p>
          </div>

          <div class="drop-panel">
            <div class="drop-label">upload links · for people without an account</div>
            <form id="link-form" class="drop-links-form">
              <div class="drop-field">
                <label class="drop-label" for="link-label">who is it for</label>
                <input id="link-label" class="drop-input" maxlength="60" placeholder="e.g. Mom, tax docs" required />
              </div>
              <div class="drop-field">
                <label class="drop-label" for="link-hours">expires in</label>
                <select id="link-hours" class="drop-input">
                  <option value="1">1 hour</option>
                  <option value="24" selected>1 day</option>
                  <option value="72">3 days</option>
                  <option value="168">7 days</option>
                </select>
              </div>
              <div class="drop-field">
                <label class="drop-label" for="link-files">max files</label>
                <select id="link-files" class="drop-input">
                  <option>1</option>
                  <option>5</option>
                  <option selected>10</option>
                  <option>25</option>
                  <option>50</option>
                </select>
              </div>
              <button type="submit" class="drop-btn">Create link</button>
            </form>
            <div id="link-new" class="drop-url" hidden>
              <input id="link-url" class="drop-input" readonly aria-label="new upload link" />
              <button id="link-copy" type="button" class="drop-btn">Copy</button>
            </div>
            <p id="link-msg" class="drop-msg" role="status"></p>
            <ul id="links" class="drop-inbox"></ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  type Item = { key: string; name: string; from: string | null; size: number; modified: string; url: string };
  type Link = {
    id: string;
    label: string;
    from: string;
    created: string;
    expires: string;
    maxFiles: number;
    used: number;
    remaining: number;
    state: 'active' | 'expired' | 'revoked' | 'used up';
  };
  type Config = { endpoint: string; issuer?: string; clientId?: string; authorize?: string; token?: string; endSession?: string | null };

  const root = document.getElementById('drop')!;
  const cfg: Config = JSON.parse(root.dataset.config ?? '{}');
  const REDIRECT = `${location.origin}/drop/`;
  const TOKEN_KEY = 'drop-session';
  const PKCE_KEY = 'drop-pkce';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const signinPanel = $<HTMLDivElement>('signin');
  const unlocked = $<HTMLDivElement>('unlocked');
  const fileInput = $<HTMLInputElement>('file-input');
  const dropzone = $<HTMLLabelElement>('dropzone');
  const uploads = $<HTMLUListElement>('uploads');
  const inbox = $<HTMLUListElement>('inbox');
  const linksList = $<HTMLUListElement>('links');

  let accessToken = '';

  // sessionStorage only: the token dies with the tab. The identity provider's own session makes signing in again one click.
  // Storage can throw (private windows, blocked site data); the page then just signs in every time.
  const session = {
    get<T>(key: string): T | null { try { return JSON.parse(sessionStorage.getItem(key) ?? 'null'); } catch { return null; } },
    set(key: string, value: unknown) { try { sessionStorage.setItem(key, JSON.stringify(value)); } catch {} },
    clear(key: string) { try { sessionStorage.removeItem(key); } catch {} },
  };

  function say(id: string, text: string, error = false) {
    const el = $(id);
    el.textContent = text;
    el.classList.toggle('error', error);
  }

  class AuthError extends Error {}

  async function api<T>(path: string, body: object = {}): Promise<T> {
    const res = await fetch(cfg.endpoint + path, {
      method: 'POST',
      headers: { 'content-type': 'application/json', authorization: `Bearer ${accessToken}` },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (res.status === 401) throw new AuthError(data.error ?? 'Please sign in again');
    if (!res.ok) throw new Error(data.error ?? `Request failed (${res.status})`);
    return data as T;
  }

  // ---------- sign-in (OIDC authorization code + PKCE, public client) ----------

  const b64url = (bytes: ArrayBuffer | Uint8Array) =>
    btoa(String.fromCharCode(...new Uint8Array(bytes))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const random = (n: number) => b64url(crypto.getRandomValues(new Uint8Array(n)));

  async function signIn() {
    const verifier = random(48);
    const state = random(16);
    const challenge = b64url(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier)));
    session.set(PKCE_KEY, { state, verifier });
    const params = new URLSearchParams({
      response_type: 'code',
      client_id: cfg.clientId!,
      redirect_uri: REDIRECT,
      scope: 'openid profile',
      state,
      code_challenge: challenge,
      code_challenge_method: 'S256',
    });
    location.assign(`${cfg.authorize}?${params}`);
  }

  async function finishSignIn(params: URLSearchParams) {
    history.replaceState(null, '', location.pathname); // drop ?code=&state= from the address bar and history
    const saved = session.get<{ state: string; verifier: string }>(PKCE_KEY);
    session.clear(PKCE_KEY);
    if (params.get('error')) throw new Error(params.get('error_description') || params.get('error')!);
    if (!saved || saved.state !== params.get('state')) throw new Error('Sign-in did not match this tab. Try again.');
    const res = await fetch(cfg.token!, {
      method: 'POST',
      headers: { 'content-type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        grant_type: 'authorization_code',
        code: params.get('code') ?? '',
        redirect_uri: REDIRECT,
        client_id: cfg.clientId!,
        code_verifier: saved.verifier,
      }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.access_token) throw new Error(data.error_description || data.error || `Sign-in failed (${res.status})`);
    session.set(TOKEN_KEY, { token: data.access_token, expires: Date.now() + (data.expires_in ?? 3600) * 1000 });
  }

  function showSignIn(message = '', error = false) {
    accessToken = '';
    session.clear(TOKEN_KEY);
    unlocked.hidden = true;
    signinPanel.hidden = false;
    inbox.replaceChildren();
    linksList.replaceChildren();
    say('signin-msg', message, error);
  }

  const onAuthError = (err: unknown) => {
    if (err instanceof AuthError) {
      showSignIn('Your session ended. Sign in again.', true);
      return true;
    }
    return false;
  };

  async function open() {
    say('signin-msg', 'opening…');
    try {
      await Promise.all([refresh(), refreshLinks()]);
    } catch (err) {
      if (!onAuthError(err)) say('signin-msg', (err as Error).message, true);
      return;
    }
    signinPanel.hidden = true;
    unlocked.hidden = false;
  }

  function signOut() {
    showSignIn('Signed out.');
    // Also end the identity-provider session, so a shared or work computer is fully logged out.
    if (cfg.endSession) location.assign(cfg.endSession);
  }

  // ---------- inbox ----------

  const fmtSize = (n: number) =>
    n < 1024 ? `${n} B` : n < 1048576 ? `${(n / 1024).toFixed(1)} KB` : `${(n / 1048576).toFixed(1)} MB`;
  const fmtTime = (iso: string) =>
    new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });

  function button(label: string, onClick: () => void, extra = '') {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = `drop-link ${extra}`.trim();
    b.textContent = label;
    b.addEventListener('click', onClick);
    return b;
  }

  function renderItem(item: Item) {
    const li = document.createElement('li');
    const isNote = item.key.endsWith('/note.txt');

    const name = document.createElement('div');
    name.className = 'drop-item-name';
    name.textContent = isNote ? 'Note' : item.name;

    const meta = document.createElement('div');
    meta.className = 'drop-item-meta';
    meta.textContent = `${fmtTime(item.modified)} · ${fmtSize(item.size)}`;
    if (item.from) {
      const from = document.createElement('span');
      from.className = 'drop-from';
      from.textContent = ` · from ${item.from}`;
      meta.append(from);
    }

    const actions = document.createElement('div');
    actions.className = 'drop-item-actions';

    if (isNote) {
      actions.append(
        button('view', async () => {
          const opened = li.querySelector('.drop-item-note');
          if (opened) return opened.remove();
          const pre = document.createElement('div');
          pre.className = 'drop-item-note';
          pre.textContent = 'loading…';
          li.append(pre);
          try {
            pre.textContent = (await api<{ text: string }>('/read', { key: item.key })).text;
          } catch (err) {
            if (!onAuthError(err)) pre.textContent = (err as Error).message;
          }
        }),
        button('copy', async () => {
          try {
            const { text } = await api<{ text: string }>('/read', { key: item.key });
            await navigator.clipboard.writeText(text);
            say('inbox-msg', 'Note copied');
          } catch (err) {
            if (!onAuthError(err)) say('inbox-msg', (err as Error).message, true);
          }
        }),
      );
    } else {
      const a = document.createElement('a');
      a.className = 'drop-link';
      a.href = item.url;
      a.textContent = 'download';
      actions.append(a);
    }

    actions.append(
      button('delete', async () => {
        if (!confirm(`Delete ${isNote ? 'this note' : item.name}? A copy already pulled into the private archive stays there.`)) return;
        try {
          await api('/delete', { key: item.key });
          li.remove();
        } catch (err) {
          if (!onAuthError(err)) say('inbox-msg', (err as Error).message, true);
        }
      }, 'danger'),
    );

    li.append(name, actions, meta);
    return li;
  }

  async function refresh() {
    const { items } = await api<{ items: Item[] }>('/list');
    inbox.replaceChildren(...items.map(renderItem));
    say('inbox-msg', items.length ? '' : 'Nothing here yet.');
  }

  async function safeRefresh() {
    try {
      await refresh();
    } catch (err) {
      if (!onAuthError(err)) say('inbox-msg', (err as Error).message, true);
    }
  }

  function uploadFile(file: File) {
    const li = document.createElement('li');
    const label = document.createElement('span');
    const bar = document.createElement('progress');
    label.textContent = `${file.name} · ${fmtSize(file.size)}`;
    bar.max = 100;
    bar.value = 0;
    li.append(label, bar);
    uploads.prepend(li);

    return api<{ url: string; fields: Record<string, string> }>('/upload', { name: file.name, size: file.size, type: file.type })
      .then(({ url, fields }) => postToS3(url, fields, file, bar))
      .then(() => {
        bar.remove();
        label.textContent = `✓ ${file.name}`;
      })
      .catch((err) => {
        if (onAuthError(err)) return;
        bar.remove();
        label.textContent = `✕ ${file.name} — ${err.message}`;
        li.classList.add('drop-msg', 'error');
      });
  }

  function postToS3(url: string, fields: Record<string, string>, file: File, bar: HTMLProgressElement) {
    return new Promise<void>((resolve, reject) => {
      const form = new FormData();
      for (const [k, v] of Object.entries(fields)) form.append(k, v);
      form.append('file', file); // must be the last field for S3
      const xhr = new XMLHttpRequest();
      xhr.open('POST', url);
      xhr.upload.onprogress = (e) => { if (e.lengthComputable) bar.value = (e.loaded / e.total) * 100; };
      xhr.onload = () => (xhr.status < 300 ? resolve() : reject(new Error(`Upload failed (${xhr.status})`)));
      xhr.onerror = () => reject(new Error('Upload failed (network)'));
      xhr.send(form);
    });
  }

  async function uploadAll(files: FileList | File[]) {
    const list = Array.from(files);
    if (!list.length) return;
    await Promise.all(list.map(uploadFile));
    await safeRefresh();
  }

  // ---------- upload links ----------

  function renderLink(link: Link) {
    const li = document.createElement('li');
    const name = document.createElement('div');
    name.className = 'drop-item-name';
    name.textContent = link.label;
    const badge = document.createElement('span');
    badge.className = `drop-badge ${link.state === 'active' ? 'active' : ''}`;
    badge.textContent = link.state;
    name.append(badge);

    const meta = document.createElement('div');
    meta.className = 'drop-item-meta';
    const when = link.state === 'active' ? `expires ${fmtTime(link.expires)}` : `created ${fmtTime(link.created)}`;
    meta.textContent = `${link.used} of ${link.maxFiles} files · ${when}`;

    const actions = document.createElement('div');
    actions.className = 'drop-item-actions';
    if (link.state === 'active') {
      actions.append(
        button('revoke', async () => {
          if (!confirm(`Revoke the link for ${link.label}? It stops working right away.`)) return;
          try {
            await api('/links/revoke', { id: link.id });
            await refreshLinks();
          } catch (err) {
            if (!onAuthError(err)) say('link-msg', (err as Error).message, true);
          }
        }, 'danger'),
      );
    }
    li.append(name, actions, meta);
    return li;
  }

  async function refreshLinks() {
    const { links } = await api<{ links: Link[] }>('/links');
    linksList.replaceChildren(...links.map(renderLink));
  }

  $<HTMLFormElement>('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const label = $<HTMLInputElement>('link-label');
    say('link-msg', 'creating…');
    try {
      const { token } = await api<{ token: string }>('/links/create', {
        label: label.value,
        hours: Number($<HTMLSelectElement>('link-hours').value),
        maxFiles: Number($<HTMLSelectElement>('link-files').value),
      });
      // The token lives in the #fragment, which browsers never send to a server.
      $<HTMLInputElement>('link-url').value = `${location.origin}/drop/send/#${token}`;
      $('link-new').hidden = false;
      label.value = '';
      say('link-msg', 'Copy it now: the link is shown only once.');
      await refreshLinks();
    } catch (err) {
      if (!onAuthError(err)) say('link-msg', (err as Error).message, true);
    }
  });

  $('link-copy').addEventListener('click', async () => {
    const input = $<HTMLInputElement>('link-url');
    try {
      await navigator.clipboard.writeText(input.value);
      say('link-msg', 'Link copied.');
    } catch {
      input.select();
      say('link-msg', 'Press Ctrl+C to copy.');
    }
  });

  // ---------- wiring ----------

  $('signin-btn').addEventListener('click', () => {
    signIn().catch((err) => say('signin-msg', (err as Error).message, true));
  });
  $('signout').addEventListener('click', signOut);
  $('refresh').addEventListener('click', () => {
    safeRefresh();
    refreshLinks().catch(onAuthError);
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files) uploadAll(fileInput.files);
    fileInput.value = '';
  });

  for (const type of ['dragenter', 'dragover']) {
    dropzone.addEventListener(type, (e) => {
      e.preventDefault();
      dropzone.classList.add('over');
    });
  }
  for (const type of ['dragleave', 'drop']) {
    dropzone.addEventListener(type, () => dropzone.classList.remove('over'));
  }
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files) uploadAll(e.dataTransfer.files);
  });

  // Pasting a file or image anywhere on the page uploads it.
  document.addEventListener('paste', (e) => {
    if (unlocked.hidden || (e.target as HTMLElement).closest('textarea, input')) return;
    const files = Array.from(e.clipboardData?.files ?? []);
    if (files.length) uploadAll(files);
  });

  $<HTMLFormElement>('note-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const note = $<HTMLTextAreaElement>('note');
    if (!note.value.trim()) return;
    say('note-msg', 'sending…');
    try {
      await api('/note', { text: note.value });
      note.value = '';
      say('note-msg', 'Sent');
      await safeRefresh();
    } catch (err) {
      if (!onAuthError(err)) say('note-msg', (err as Error).message, true);
    }
  });

  async function start() {
    if (!cfg.endpoint || !cfg.authorize || !cfg.token || !cfg.clientId) {
      say('signin-msg', 'Drop box is not configured yet.', true);
      $<HTMLButtonElement>('signin-btn').disabled = true;
      return;
    }
    const params = new URLSearchParams(location.search);
    if (params.has('code') || params.has('error')) {
      say('signin-msg', 'signing in…');
      try {
        await finishSignIn(params);
      } catch (err) {
        return say('signin-msg', (err as Error).message, true);
      }
    }
    const saved = session.get<{ token: string; expires: number }>(TOKEN_KEY);
    if (saved && saved.expires > Date.now() + 30_000) {
      accessToken = saved.token;
      await open();
    } else {
      session.clear(TOKEN_KEY);
    }
  }

  start();
</script>
