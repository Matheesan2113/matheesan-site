---
import SiteLayout from '../layouts/site.astro';
import PageHeader from '../components/PageHeader.astro';
import MlLab from '../components/MlLab.astro';
import Homelab from '../components/Homelab.astro';
import Access from '../components/Access.astro';
---

<SiteLayout
  title="Lab — Matheesan"
  description="The lab behind the work: production LLM agent loops, evals, private local inference, computer vision and the homelab underneath — published as capabilities, not coordinates."
  theme="lab"
>
  <PageHeader
    crumb="lab"
    title="The lab."
    channel="ch.03 / lab"
    glyph="実"
    deck="Where the models meet the metal. Production agent loops and eval tooling up top; private local inference, computer vision, storage and a segmented network underneath — at the level of capability, not coordinates."
  />

  <div class="lab-hud mono" aria-label="Lab status">
    <span><i aria-hidden="true"></i>lab / public view</span>
    <span>local inference</span>
    <span>computer vision</span>
    <span>private storage</span>
    <span class="lab-hud-ok">specifics withheld</span>
  </div>

  <div class="container">
    <figure class="lab-figure">
      <img src="/art/lab-topology.svg" alt="An abstract public summary of the lab: local compute, private services, a segmented network and tested backups, with hosts, addresses, versions and the service map redacted." width="1200" height="700" loading="lazy" decoding="async" />
      <figcaption class="mono">public view / not a network map</figcaption>
    </figure>
  </div>

  <MlLab />
  <Homelab />
  <Access />
</SiteLayout>

<style is:global>
  .lab-hud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    align-items: center;
    padding: 0.7rem 2rem;
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    text-transform: uppercase;
  }

  .lab-hud span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .lab-hud i { width: 5px; height: 5px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px var(--ok); }
  .lab-hud-ok { color: var(--ok); }

  @media (max-width: 700px) {
    .lab-hud { padding: 0.7rem 1.2rem; gap: 0.35rem 0.8rem; }
  }

  .lab-figure {
    margin: 2.2rem 0 0;
    border: 1px solid var(--line);
    background: var(--bg2);
  }

  .lab-figure img { display: block; width: 100%; height: auto; }

  .lab-figure figcaption {
    padding: 0.55rem 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--text3);
  }

  #ml { padding-top: 2.5rem; padding-bottom: 4rem; }
  #homelab { padding-top: 4rem; padding-bottom: 4rem; }
  #access { padding-top: 4rem; padding-bottom: 5rem; }
</style>
