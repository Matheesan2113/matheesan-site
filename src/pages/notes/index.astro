---
import Layout from '../../layouts/layout.astro';
import Cursor from '../../components/Cursor.astro';
import Nav from '../../components/Nav.astro';
import CommandPalette from '../../components/CommandPalette.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (date: Date) =>
  date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Field notes — Matheesan"
  description="Notes on production AI, evals, testing and systems: silent green, cache replay, and the gap between a green suite and a working call."
>
  <Cursor />
  <Nav />
  <CommandPalette />

  <main id="main" class="notes-page">
    <section>
      <div class="container">
        <p class="section-label"><a href="/">matheesan.ca</a> / notes</p>
        <h1 class="section-title">Field <em>notes</em>.</h1>
        <p class="section-deck">
          Notes from production AI, testing and systems work. Mostly written so I stop relearning the
          same lesson — and in case they save someone else a day.
        </p>

        <div class="notes-index">
          {notes.map((note, index) => (
            <a class="notes-index-row" href={`/notes/${note.id}/`}>
              <span class="notes-index-num mono">{String(index + 1).padStart(2, '0')}</span>
              <span class="notes-index-main">
                <span class="notes-index-meta mono">{fmt(note.data.date)} · {note.data.reading} read</span>
                <span class="notes-index-title">{note.data.title}</span>
                <span class="notes-index-desc">{note.data.description}</span>
                <span class="notes-index-tags">
                  {note.data.tags.map((tag) => <span>{tag}</span>)}
                </span>
              </span>
              <span class="notes-index-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="notes-page-foot">
          <a href="/" class="btn-ghost btn-small">← back to matheesan.ca</a>
          <a href="/rss.xml" class="mono rss">rss feed ↗</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .notes-page section { padding-top: 8rem; min-height: 100vh; }

  .notes-page .section-label a { color: inherit; text-decoration: none; }
  .notes-page .section-label a:hover { color: var(--accent2); }

  .notes-index { border-top: 1px solid var(--line); }

  .notes-index-row {
    display: grid;
    grid-template-columns: 52px 1fr 24px;
    gap: 1.2rem;
    align-items: start;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.2s;
  }

  .notes-index-row:hover { background: rgba(14, 24, 40, 0.45); }

  .notes-index-num {
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    padding-top: 0.3rem;
  }

  .notes-index-main { display: flex; flex-direction: column; gap: 0.3rem; }

  .notes-index-meta { font-size: 0.53rem; letter-spacing: 0.08em; color: var(--text3); }

  .notes-index-title {
    font-family: var(--serif);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text1);
    transition: color 0.2s;
  }

  .notes-index-row:hover .notes-index-title { color: var(--accent2); }

  .notes-index-desc { font-size: 0.88rem; line-height: 1.65; color: var(--text2); max-width: 720px; }

  .notes-index-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.35rem; }

  .notes-index-tags span {
    font-family: var(--mono);
    font-size: 0.5rem;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.12rem 0.35rem;
  }

  .notes-index-arrow {
    font-family: var(--mono);
    color: var(--text3);
    padding-top: 0.35rem;
    transition: color 0.2s, transform 0.2s;
  }

  .notes-index-row:hover .notes-index-arrow { color: var(--accent); transform: translateX(4px); }

  .notes-page-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .rss { font-size: 0.55rem; letter-spacing: 0.08em; color: var(--text3); text-decoration: none; }
  .rss:hover { color: var(--accent); }

  @media (max-width: 620px) {
    .notes-index-row { grid-template-columns: 32px 1fr 16px; gap: 0.7rem; }
    .notes-index-title { font-size: 1.4rem; }
    .notes-index-desc { font-size: 0.82rem; }
  }
</style>
