---
import SiteLayout from '../../layouts/site.astro';
import PageHeader from '../../components/PageHeader.astro';
import JobTimeline from '../../components/JobTimeline.astro';
import CareerEvolution from '../../components/CareerEvolution.astro';
import CaseCard from '../../components/CaseCard.astro';
import AlsoBuilt from '../../components/AlsoBuilt.astro';
import PlatformLayers from '../../components/PlatformLayers.astro';
import EarlyProjects from '../../components/EarlyProjects.astro';
import WorkbenchFeature from '../../components/WorkbenchFeature.astro';
import { caseFiles, site } from '../../data/profile';
---

<SiteLayout
  title="Career — Matheesan"
  description="Matheesan’s career: now building WayTrade’s AI-powered marketplace for biofuels and feedstocks; previously production LLM systems, RAG, evals and AI tooling."
  theme="career"
>
  <PageHeader
    crumb="career"
    title="Career, measured in loops."
    channel="ch.06 / work"
    glyph="職"
    deck="Now building WayTrade’s marketplace for biofuels and feedstocks. Before that: forward-deployed AI, enterprise ML and a habit of finding the bug the green suite is hiding. The through-line is production software and the tooling around it."
  />

  <div class="career-hud mono">
    <span class="career-hud-label">long-form portfolio · case files · tooling</span>
    <span class="career-hud-links">
      <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">linkedin <span aria-hidden="true">↗</span></a>
      <a href="/resume/">printable résumé <span aria-hidden="true">→</span></a>
    </span>
  </div>

  <section class="work-section">
    <div class="container">
      <JobTimeline />
      <CareerEvolution />
    </div>
  </section>

  <WorkbenchFeature />

  <EarlyProjects />
  <PlatformLayers />

  <section class="work-case-section">
    <div class="container">
      <div class="case-section">
        <div class="case-section-head">
          <div>
            <p class="section-label">selected work</p>
            <h2 class="section-title">Case <em>files</em>.</h2>
          </div>
          <p class="case-section-note mono">
            public-safe · customer names omitted · technical detail kept
          </p>
        </div>

        <div class="case-grid">
          {caseFiles.map((file) => <CaseCard file={file} />)}
        </div>
      </div>

      <AlsoBuilt />
    </div>
  </section>
</SiteLayout>

<style>
  .career-hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 2rem;
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    text-transform: uppercase;
  }

  .career-hud-links { display: flex; flex-wrap: wrap; gap: 1.2rem; }

  .career-hud a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.1rem;
  }

  .career-hud a:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  .work-section { padding: 2.5rem 0 4rem; }

  .work-case-section { padding: 4rem 0 6rem; background: var(--bg); }

  .case-section { margin-top: 0; }

  .case-section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .case-section-head .section-title { margin-bottom: 0; }

  .case-section-note {
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    text-align: right;
    max-width: 220px;
    line-height: 1.7;
  }

  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
  }

  @media (max-width: 900px) {
    .case-section-head { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .case-section-note { text-align: left; max-width: none; }
    .case-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .career-hud {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
      padding: 0.7rem 1.2rem;
    }
  }
</style>
