---
import SiteLayout from '../layouts/site.astro';
import PageHeader from '../components/PageHeader.astro';
import WukongSpotlight from '../components/WukongSpotlight.astro';
import { games, site } from '../data/profile';
---

<SiteLayout
  title="Games — Matheesan"
  description="Matheesan's game rotation: Elden Ring, Black Myth: Wukong, Mario Kart, Valorant and Overwatch — plus Steam and PSN. Boss fights, party games and the occasional blue shell."
  theme="games"
>
  <PageHeader
    crumb="games"
    title="Boss fights and party games."
    channel="ch.02 / play"
    glyph="遊"
    deck="The games I keep coming back to — a soulslike, a monkey king, a blue-shell simulator, a tac shooter and a team fight. Not a ranking; a rotation."
  />

  <div class="game-hud mono" aria-label="Game status">
    <span><i aria-hidden="true"></i>save 01</span>
    <span>rotation 05</span>
    <span>mode co-op</span>
    <span>input keyboard / controller</span>
    <span class="game-hud-ok">status one more run</span>
  </div>

  <WukongSpotlight />

  <section id="games">
    <div class="container">
      <div class="game-now">
        <div><span class="mono">current wall</span><strong>Wukong</strong></div>
        <div><span class="mono">comfort game</span><strong>Mario Kart</strong></div>
        <div><span class="mono">all-time</span><strong>Elden Ring</strong></div>
      </div>

      <div class="games-head">
        <div>
          <p class="section-label">the rotation</p>
          <h2 class="section-title">Five saves, one <em>attention span</em>.</h2>
        </div>
        <p class="games-note mono">not ranked · not finished · still playing</p>
      </div>

      <div class="game-grid">
        {games.map((game) => (
          <article class:list={['game-card', { 'game-featured': game.id === 'elden-ring' }]} id={game.id}>
            <img class="game-art" src={game.art} alt="" width="1200" height="675" loading="lazy" decoding="async" />
            <div class="game-content">
              <div class="game-top">
                <span class="mono">{game.status}</span>
                <span class="mono">{game.kind}</span>
              </div>
              <h3>{game.title}</h3>
              <p class="game-body">{game.body}</p>
              <div class="game-tags">
                {game.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="why-games">
    <div class="container">
      <div class="why-grid">
        <div>
          <p class="section-label">why games</p>
          <h2 class="section-title">Practice <em>losing</em>.</h2>
        </div>
        <div class="why-copy">
          <p>
            Games are how I practice losing a hundred times without making it mean anything. Learn the
            system, find the tell, try again. Same as engineering — except the feedback loop is shorter
            and the blue shells are personal.
          </p>
          <p class="mono why-foot">co-op &gt; solo · one more run · touch the point</p>
        </div>
      </div>
    </div>
  </section>

  <section id="gaming-network">
    <div class="container">
      <div class="network-head">
        <div>
          <p class="section-label">// gaming network</p>
          <h2 class="section-title">Same <em>lobby</em>.</h2>
        </div>
        <p class="network-note mono">two platforms · one friend list</p>
      </div>

      <p class="section-deck network-deck">
        Steam for the long games and the backlog. PSN for the couch and the controller. Add me and
        say what you’re playing.
      </p>

      <div class="network-grid">
        <a class="network-card network-card-steam" href={site.socials.steam} target="_blank" rel="noopener noreferrer">
          <span class="network-platform mono">steam</span>
          <span class="network-handle">DragonKingSlayer25</span>
          <span class="network-name mono">profile / {site.steamName}</span>
          <span class="network-action mono">open profile <span aria-hidden="true">↗</span></span>
        </a>

        <div class="network-card network-card-psn">
          <span class="network-platform mono">psn</span>
          <span class="network-handle" id="psn-handle">{site.psn}</span>
          <span class="network-name mono">playstation network</span>
          <button type="button" class="network-copy mono" data-copy-psn data-copy-value={site.psn} aria-label={`Copy PSN ID ${site.psn}`}>
            copy id
          </button>
          <span class="network-status mono" id="psn-copy-status" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </section>

  <section id="games-next">
    <div class="container">
      <div class="music-next-row">
        <p class="mono">next on the map</p>
        <div>
          <a href="/music/" class="section-link mono">the booth <span aria-hidden="true">→</span></a>
          <a href="/lab/" class="section-link mono">the lab <span aria-hidden="true">→</span></a>
          <a href="/about/" class="section-link mono">the longer version <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .game-hud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    align-items: center;
    padding: 0.7rem 2rem;
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    text-transform: uppercase;
  }

  .game-hud span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .game-hud i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
  .game-hud-ok { color: var(--accent); }

  @media (max-width: 700px) {
    .game-hud { padding: 0.7rem 1.2rem; gap: 0.35rem 0.8rem; }
  }

  #games { padding-top: 2.5rem; padding-bottom: 5.5rem; background: var(--bg); }
  #why-games { background: var(--bg2); padding: 5.5rem 0; }
  #gaming-network { background: var(--bg); padding: 5.5rem 0; }
  #games-next { background: var(--bg2); padding: 2.5rem 0; border-top: 1px solid var(--line); }

  .game-now {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
    margin-bottom: 4rem;
  }

  .game-now > div {
    background: var(--bg2);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .game-now .mono { font-size: 0.5rem; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; }
  .game-now strong { font-family: var(--serif); font-size: 1.35rem; font-weight: 400; color: var(--moon); }

  .games-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .games-head .section-title { margin-bottom: 0; }
  .games-note { font-size: 0.52rem; letter-spacing: 0.06em; color: var(--text3); text-align: right; max-width: 220px; }

  .game-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .game-card {
    background: var(--bg2);
    padding: 0;
    scroll-margin-top: 6rem;
    display: flex;
    flex-direction: column;
    min-height: 260px;
    overflow: hidden;
    transition: background 0.25s;
  }

  .game-art {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .game-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.35rem 1.5rem 1.4rem;
  }

  .game-featured .game-art { aspect-ratio: 16 / 9; }

  .game-card:hover { background: var(--bg3); }

  .game-featured {
    grid-column: 1 / -1;
    min-height: 0;
    background:
      radial-gradient(ellipse 70% 120% at 100% 0%, rgba(88, 174, 201, 0.08), transparent 65%),
      var(--bg2);
  }

  .game-top { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
  .game-top .mono { font-size: 0.5rem; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; }
  .game-top .mono:first-child { color: var(--accent); }

  .game-card h3 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text1);
    margin-bottom: 0.7rem;
  }

  .game-featured h3 { font-size: clamp(2.6rem, 6vw, 4.6rem); }

  .game-body { max-width: 68ch; font-size: 0.9rem; line-height: 1.8; color: var(--text2); margin-bottom: 1.3rem; }

  .game-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: auto; }

  .game-tags span {
    font-family: var(--mono);
    font-size: 0.48rem;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.16rem 0.34rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: start;
  }

  .why-copy p { font-size: 0.95rem; line-height: 1.85; color: var(--text2); max-width: 58ch; }
  .why-copy p + p { margin-top: 1rem; }
  .why-foot { font-size: 0.55rem; letter-spacing: 0.06em; color: var(--accent); }

  .network-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .network-head .section-title { margin-bottom: 0; }
  .network-note { font-size: 0.5rem; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; white-space: nowrap; }
  .network-deck { max-width: 62ch; margin-bottom: 2rem; }

  .network-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .network-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: 1.5rem 1.5rem 1.3rem;
    background: var(--bg2);
    text-decoration: none;
    overflow: hidden;
    transition: background 0.2s;
  }

  .network-card::after {
    content: '';
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 18px;
    height: 18px;
    border-right: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
    opacity: 0.45;
  }

  .network-card:hover { background: var(--bg3); }

  .network-card-steam {
    background:
      radial-gradient(ellipse 80% 100% at 100% 0%, rgba(168, 255, 96, 0.07), transparent 65%),
      var(--bg2);
    border-left: 2px solid var(--accent);
  }

  .network-card-psn {
    background:
      radial-gradient(ellipse 80% 100% at 100% 0%, rgba(127, 178, 255, 0.07), transparent 65%),
      var(--bg2);
    border-left: 2px solid var(--moon2);
  }

  .network-platform { font-size: 0.52rem; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 1.2rem; }
  .network-card-psn .network-platform { color: var(--moon2); }
  .network-handle { font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 2.9rem); font-weight: 300; line-height: 1; color: var(--text1); }
  .network-name { margin-top: 0.55rem; font-size: 0.48rem; letter-spacing: 0.08em; color: var(--text3); }
  .network-action { margin-top: auto; padding-top: 1.4rem; color: var(--accent); font-size: 0.54rem; letter-spacing: 0.08em; }

  .network-copy {
    align-self: flex-start;
    margin-top: auto;
    background: none;
    border: 1px solid var(--wave2);
    color: var(--moon2);
    padding: 0.38rem 0.6rem;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .network-copy:hover { border-color: var(--accent); color: var(--accent2); }
  .network-status { margin-top: 0.45rem; min-height: 1em; font-size: 0.48rem; color: var(--ok); letter-spacing: 0.06em; }

  .music-next-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .music-next-row > p { font-size: 0.55rem; letter-spacing: 0.1em; color: var(--text3); text-transform: uppercase; }
  .music-next-row > div { display: flex; flex-wrap: wrap; gap: 1.4rem; justify-content: flex-end; }

  .section-link {
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }

  .section-link:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  @media (max-width: 900px) {
    .network-head { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .network-grid { grid-template-columns: 1fr; }
    .network-card { min-height: 210px; }
    .game-now { grid-template-columns: 1fr; margin-bottom: 2.5rem; }
    .games-head { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .games-note { text-align: left; max-width: none; }
    .game-grid { grid-template-columns: 1fr; }
    .game-featured { grid-column: auto; }
    .why-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  @media (max-width: 600px) {
    .network-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .network-head .section-title { margin-bottom: 0; }
  .network-note { font-size: 0.5rem; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; white-space: nowrap; }
  .network-deck { max-width: 62ch; margin-bottom: 2rem; }

  .network-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .network-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: 1.5rem 1.5rem 1.3rem;
    background: var(--bg2);
    text-decoration: none;
    overflow: hidden;
    transition: background 0.2s;
  }

  .network-card::after {
    content: '';
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 18px;
    height: 18px;
    border-right: 1px solid var(--accent);
    border-bottom: 1px solid var(--accent);
    opacity: 0.45;
  }

  .network-card:hover { background: var(--bg3); }

  .network-card-steam {
    background:
      radial-gradient(ellipse 80% 100% at 100% 0%, rgba(168, 255, 96, 0.07), transparent 65%),
      var(--bg2);
    border-left: 2px solid var(--accent);
  }

  .network-card-psn {
    background:
      radial-gradient(ellipse 80% 100% at 100% 0%, rgba(127, 178, 255, 0.07), transparent 65%),
      var(--bg2);
    border-left: 2px solid var(--moon2);
  }

  .network-platform { font-size: 0.52rem; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 1.2rem; }
  .network-card-psn .network-platform { color: var(--moon2); }
  .network-handle { font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 2.9rem); font-weight: 300; line-height: 1; color: var(--text1); }
  .network-name { margin-top: 0.55rem; font-size: 0.48rem; letter-spacing: 0.08em; color: var(--text3); }
  .network-action { margin-top: auto; padding-top: 1.4rem; color: var(--accent); font-size: 0.54rem; letter-spacing: 0.08em; }

  .network-copy {
    align-self: flex-start;
    margin-top: auto;
    background: none;
    border: 1px solid var(--wave2);
    color: var(--moon2);
    padding: 0.38rem 0.6rem;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .network-copy:hover { border-color: var(--accent); color: var(--accent2); }
  .network-status { margin-top: 0.45rem; min-height: 1em; font-size: 0.48rem; color: var(--ok); letter-spacing: 0.06em; }

  .music-next-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .music-next-row > div { justify-content: flex-start; }
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-psn]');
  const copyStatus = document.getElementById('psn-copy-status');
  copyButton?.addEventListener('click', async () => {
    const value = copyButton.dataset.copyValue ?? 'matheesan25';
    try {
      await navigator.clipboard.writeText(value);
      if (copyStatus) copyStatus.textContent = 'copied to clipboard';
    } catch {
      const handle = document.getElementById('psn-handle');
      if (handle) {
        const range = document.createRange();
        range.selectNodeContents(handle);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        try {
          const copied = document.execCommand('copy');
          if (copyStatus) copyStatus.textContent = copied ? 'copied to clipboard' : 'press ctrl / cmd + C';
          if (copied) selection?.removeAllRanges();
        } catch {
          if (copyStatus) copyStatus.textContent = 'press ctrl / cmd + C';
        }
      }
    }
    window.setTimeout(() => { if (copyStatus) copyStatus.textContent = ''; }, 2200);
  });
</script>
