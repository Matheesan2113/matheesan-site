---
import SiteLayout from '../layouts/site.astro';
import PageHeader from '../components/PageHeader.astro';
import { games } from '../data/profile';
---

<SiteLayout
  title="Games — Matheesan"
  description="Matheesan's game rotation: Elden Ring, Black Myth: Wukong, Mario Kart, Valorant and Overwatch. Boss fights, party games and the occasional blue shell."
>
  <PageHeader
    crumb="games"
    title="Boss fights and party games."
    deck="The games I keep coming back to — a soulslike, a monkey king, a blue-shell simulator, a tac shooter and a team fight. Not a ranking; a rotation."
  />

  <section id="games">
    <div class="container">
      <div class="game-now">
        <div><span class="mono">current wall</span><strong>Wukong</strong></div>
        <div><span class="mono">comfort game</span><strong>Mario Kart</strong></div>
        <div><span class="mono">all-time</span><strong>Elden Ring</strong></div>
      </div>

      <div class="games-head">
        <div>
          <p class="section-label">the rotation</p>
          <h2 class="section-title">Five saves, one <em>attention span</em>.</h2>
        </div>
        <p class="games-note mono">not ranked · not finished · still playing</p>
      </div>

      <div class="game-grid">
        {games.map((game) => (
          <article class:list={['game-card', { 'game-featured': game.id === 'elden-ring' }]} id={game.id}>
            <div class="game-top">
              <span class="mono">{game.status}</span>
              <span class="mono">{game.kind}</span>
            </div>
            <h3>{game.title}</h3>
            <p class="game-body">{game.body}</p>
            <div class="game-tags">
              {game.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="why-games">
    <div class="container">
      <div class="why-grid">
        <div>
          <p class="section-label">why games</p>
          <h2 class="section-title">Practice <em>losing</em>.</h2>
        </div>
        <div class="why-copy">
          <p>
            Games are how I practice losing a hundred times without making it mean anything. Learn the
            system, find the tell, try again. Same as engineering — except the feedback loop is shorter
            and the blue shells are personal.
          </p>
          <p class="mono why-foot">co-op &gt; solo · one more run · touch the point</p>
        </div>
      </div>
    </div>
  </section>

  <section id="games-next">
    <div class="container">
      <div class="music-next-row">
        <p class="mono">next on the map</p>
        <div>
          <a href="/music/" class="section-link mono">the booth <span aria-hidden="true">→</span></a>
          <a href="/lab/" class="section-link mono">the lab <span aria-hidden="true">→</span></a>
          <a href="/about/" class="section-link mono">the longer version <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  #games { padding-top: 2.5rem; padding-bottom: 5.5rem; background: var(--bg); }
  #why-games { background: var(--bg2); padding: 5.5rem 0; }
  #games-next { background: var(--bg2); padding: 2.5rem 0; border-top: 1px solid var(--line); }

  .game-now {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
    margin-bottom: 4rem;
  }

  .game-now > div {
    background: var(--bg2);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .game-now .mono { font-size: 0.5rem; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; }
  .game-now strong { font-family: var(--serif); font-size: 1.35rem; font-weight: 400; color: var(--moon); }

  .games-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .games-head .section-title { margin-bottom: 0; }
  .games-note { font-size: 0.52rem; letter-spacing: 0.06em; color: var(--text3); text-align: right; max-width: 220px; }

  .game-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .game-card {
    background: var(--bg2);
    padding: 1.6rem 1.5rem;
    scroll-margin-top: 6rem;
    display: flex;
    flex-direction: column;
    min-height: 260px;
    transition: background 0.25s;
  }

  .game-card:hover { background: var(--bg3); }

  .game-featured {
    grid-column: 1 / -1;
    min-height: 0;
    background:
      radial-gradient(ellipse 70% 120% at 100% 0%, rgba(88, 174, 201, 0.08), transparent 65%),
      var(--bg2);
  }

  .game-top { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
  .game-top .mono { font-size: 0.5rem; letter-spacing: 0.08em; color: var(--text3); text-transform: uppercase; }
  .game-top .mono:first-child { color: var(--accent); }

  .game-card h3 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.4vw, 2.7rem);
    font-weight: 300;
    line-height: 1.05;
    color: var(--text1);
    margin-bottom: 0.7rem;
  }

  .game-featured h3 { font-size: clamp(2.6rem, 6vw, 4.6rem); }

  .game-body { max-width: 68ch; font-size: 0.9rem; line-height: 1.8; color: var(--text2); margin-bottom: 1.3rem; }

  .game-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: auto; }

  .game-tags span {
    font-family: var(--mono);
    font-size: 0.48rem;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.16rem 0.34rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 4rem;
    align-items: start;
  }

  .why-copy p { font-size: 0.95rem; line-height: 1.85; color: var(--text2); max-width: 58ch; }
  .why-copy p + p { margin-top: 1rem; }
  .why-foot { font-size: 0.55rem; letter-spacing: 0.06em; color: var(--accent); }

  .music-next-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .music-next-row > p { font-size: 0.55rem; letter-spacing: 0.1em; color: var(--text3); text-transform: uppercase; }
  .music-next-row > div { display: flex; flex-wrap: wrap; gap: 1.4rem; justify-content: flex-end; }

  .section-link {
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }

  .section-link:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  @media (max-width: 900px) {
    .game-now { grid-template-columns: 1fr; margin-bottom: 2.5rem; }
    .games-head { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .games-note { text-align: left; max-width: none; }
    .game-grid { grid-template-columns: 1fr; }
    .game-featured { grid-column: auto; }
    .why-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  @media (max-width: 600px) {
    .music-next-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .music-next-row > div { justify-content: flex-start; }
  }
</style>
