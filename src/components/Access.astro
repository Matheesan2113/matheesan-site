---
import { site } from '../data/profile';
---

<section id="access">
  <div class="container">
    <p class="section-label">access</p>
    <h2 class="section-title">The lab is <em>invite-only</em>.</h2>
    <p class="section-deck">
      I run a handful of private services for people I actually know. If you’d like access, reach out
      and I’ll set you up. Accounts are created personally; there is no public signup.
    </p>

    <a href="/contact/" class="access-card">
      <div>
        <p class="access-label mono">by invitation</p>
        <p class="access-title">Request access</p>
        <p class="access-desc">Private media, photos and files — accounts are set up personally.</p>
      </div>
      <span class="access-arrow" aria-hidden="true">→</span>
    </a>

    <div class="access-contacts">
      <a href={site.socials.linkedin} class="access-contact" target="_blank" rel="noopener noreferrer">
        <span class="access-contact-label mono">linkedin</span>
        <span class="access-contact-handle">matheesanm</span>
        <span class="access-contact-arrow" aria-hidden="true">↗</span>
      </a>
      <a href={site.socials.github} class="access-contact" target="_blank" rel="noopener noreferrer">
        <span class="access-contact-label mono">github</span>
        <span class="access-contact-handle">Matheesan2113</span>
        <span class="access-contact-arrow" aria-hidden="true">↗</span>
      </a>
      <a href={site.socials.instagram} class="access-contact" target="_blank" rel="noopener noreferrer">
        <span class="access-contact-label mono">instagram</span>
        <span class="access-contact-handle">@matheesan_m</span>
        <span class="access-contact-arrow" aria-hidden="true">↗</span>
      </a>
      <a href="/contact/" class="access-contact">
        <span class="access-contact-label mono">contact</span>
        <span class="access-contact-handle">say hello</span>
        <span class="access-contact-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="access-services mono">
      <span>private media</span>
      <span>private photos</span>
      <span>private files</span>
      <span>private drop</span>
      <span>single sign-on</span>
    </div>

    <p class="access-note mono">
      accounts are created personally · access is reviewed · no public signup
    </p>
  </div>
</section>

<style>
  #access { background: var(--bg); }

  .access-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.7rem 1.8rem;
    border: 1px solid var(--line);
    background: var(--bg2);
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
    margin-bottom: 1rem;
  }

  .access-card:hover {
    border-color: var(--accent);
    background: var(--bg3);
    transform: translateY(-2px);
  }

  .access-label {
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.45rem;
  }

  .access-title {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 300;
    color: var(--text1);
    margin-bottom: 0.25rem;
  }

  .access-desc { font-size: 0.84rem; color: var(--text2); }

  .access-arrow {
    font-family: var(--mono);
    font-size: 1.2rem;
    color: var(--text3);
    transition: color 0.25s, transform 0.25s;
  }

  .access-card:hover .access-arrow { color: var(--accent); transform: translateX(6px); }

  .access-contacts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }

  .access-contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    background: var(--bg2);
    text-decoration: none;
    transition: background 0.25s;
  }

  .access-contact:hover { background: var(--bg3); }

  .access-contact-label {
    font-size: 0.52rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .access-contact-handle {
    font-size: 0.9rem;
    color: var(--text1);
    overflow-wrap: anywhere;
  }

  .access-contact-arrow {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text3);
    margin-top: 0.2rem;
    transition: color 0.2s, transform 0.2s;
  }

  .access-contact:hover .access-contact-arrow { color: var(--accent); transform: translateX(3px); }

  .access-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--text3);
  }

  .access-services span::before { content: '· '; color: var(--wave2); }

  .access-note {
    margin-top: 1.2rem;
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--text3);
  }

  @media (max-width: 860px) {
    .access-contacts { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .access-contacts { grid-template-columns: 1fr; }
    .access-card { padding: 1.3rem; }
  }
</style>
