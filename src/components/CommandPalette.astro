<dialog id="command-palette" aria-label="Command palette">
  <div class="palette">
    <div class="palette-search">
      <span class="palette-caret" aria-hidden="true">›</span>
      <input
        id="palette-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="jump to a section or page…"
        aria-label="Search commands"
        aria-controls="palette-list"
        aria-autocomplete="list"
      />
      <span class="palette-esc" aria-hidden="true">esc</span>
    </div>
    <p id="palette-status" class="sr-only" role="status"></p>
    <ul id="palette-list" role="listbox" aria-label="Commands"></ul>
    <div class="palette-foot">
      <span><kbd>up</kbd><kbd>down</kbd> move</span>
      <span><kbd>enter</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <span class="palette-brand">matheesan.ca / index</span>
    </div>
  </div>
</dialog>

<style is:global>
  dialog#command-palette {
    position: fixed;
    inset: 0;
    margin: 12vh auto auto;
    width: min(640px, calc(100vw - 2rem));
    max-height: 70vh;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--text1);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  dialog#command-palette::backdrop {
    background: rgba(3, 6, 11, 0.72);
    backdrop-filter: blur(4px);
  }

  dialog#command-palette:not([open]) { display: none; }

  .palette { display: flex; flex-direction: column; max-height: 70vh; }

  .palette-search {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .palette-caret {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 1rem;
    line-height: 1;
  }

  #palette-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    color: var(--text1);
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  #palette-input::placeholder { color: var(--text3); }

  .palette-esc {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.2rem 0.35rem;
  }

  #palette-list {
    list-style: none;
    overflow-y: auto;
    padding: 0.4rem;
    margin: 0;
  }

  #palette-list li { margin: 0; }

  .palette-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    padding: 0.62rem 0.7rem;
    background: none;
    border: 0;
    color: var(--text2);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 0.88rem;
    transition: background 0.12s, color 0.12s;
  }

  .palette-item[aria-selected='true'],
  .palette-item:hover {
    background: var(--bg3);
    color: var(--text1);
  }

  .palette-item .pi-icon {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--accent);
    width: 2.1rem;
    flex-shrink: 0;
  }

  .palette-item .pi-label { flex: 1; }

  .palette-item .pi-group {
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--text3);
    text-transform: uppercase;
  }

  .palette-empty {
    padding: 1.2rem 0.8rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text3);
  }

  .palette-foot {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--text3);
  }

  .palette-foot kbd {
    font-family: var(--mono);
    font-size: 0.55rem;
    color: var(--text2);
    border: 1px solid var(--line);
    padding: 0.05rem 0.22rem;
    margin-right: 0.15rem;
  }

  .palette-brand { margin-left: auto; color: var(--text3); }

  @media (max-width: 600px) {
    dialog#command-palette { margin-top: 6vh; width: calc(100vw - 1.2rem); }
    .palette-brand { display: none; }
    .palette-foot { gap: 0.7rem; }
  }
</style>

<script>
  type Item = {
    label: string;
    group: string;
    icon: string;
    href?: string;
    action?: () => void;
    keywords?: string;
  };

  const dialog = document.getElementById('command-palette') as HTMLDialogElement;
  const input = document.getElementById('palette-input') as HTMLInputElement;
  const list = document.getElementById('palette-list') as HTMLUListElement;
  const status = document.getElementById('palette-status') as HTMLParagraphElement;

  const close = () => {
    if (dialog.open) dialog.close();
  };

  const copyLink = async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      status.textContent = 'Page link copied to the clipboard.';
    } catch {
      status.textContent = 'Could not copy the link.';
    }
    setTimeout(close, 350);
  };

  const items: Item[] = [
    { label: 'Home', group: 'page', icon: 'hm', href: '/', keywords: 'matheesan start landing' },
    { label: 'Music', group: 'page', icon: 'mu', href: '/music/', keywords: 'dj house disco ambient tamil hip-hop spotify crate booth' },
    { label: 'Games', group: 'page', icon: 'gm', href: '/games/', keywords: 'elden ring wukong mario kart valorant overwatch gaming' },
    { label: 'Lab', group: 'page', icon: 'lab', href: '/lab/', keywords: 'ml machine learning homelab proxmox gpu frigate immich access' },
    { label: 'Notes', group: 'page', icon: 'nt', href: '/notes/', keywords: 'writing blog field notes articles' },
    { label: 'About', group: 'page', icon: 'ab', href: '/about/', keywords: 'whoami bio identity life travel food music games' },
    { label: 'Career', group: 'page', icon: 'cr', href: '/career/', keywords: 'experience jobs resume case studies replicant cgi avaya' },
    { label: 'Tooling', group: 'page', icon: 'tl', href: '/tooling/', keywords: 'copilot cursor claude code mcp ollama whisper langchain tools workflow timeline' },
    { label: 'The crate', group: 'section', icon: 'mu', href: '/music/#crate', keywords: 'house disco ambient tamil hip-hop warm-up peak time after hours roots' },
    { label: 'Booth notes', group: 'section', icon: 'bn', href: '/music/#booth', keywords: 'dj transitions read the room practice' },
    { label: 'Game rotation', group: 'section', icon: 'gm', href: '/games/#rotation', keywords: 'elden ring wukong mario kart valorant overwatch boss fights' },
    { label: 'AI platform layers', group: 'section', icon: 'pl', href: '/career/#platform', keywords: 'routers knowledge bases rag vector search providers evals' },
    { label: 'ML lab', group: 'section', icon: 'ml', href: '/lab/#ml', keywords: 'agents evals pipeline model' },
    { label: 'Homelab', group: 'section', icon: 'hl', href: '/lab/#homelab', keywords: 'proxmox gpu ollama frigate immich storage' },
    { label: 'Life outside work', group: 'section', icon: 'lf', href: '/about/#life', keywords: 'travel food djing music games' },
    { label: 'Access', group: 'section', icon: 'ac', href: '/lab/#access', keywords: 'jellyfin immich invite authentik' },
    { label: 'Résumé', group: 'page', icon: 'cv', href: '/resume/', keywords: 'cv print pdf hiring' },
    { label: 'Contact', group: 'page', icon: '@', href: '/contact/', keywords: 'email message hello' },
    { label: 'Drop box', group: 'page', icon: 'db', href: '/drop/', keywords: 'files upload private' },
    { label: 'The production voice agent', group: 'case', icon: '01', href: '/career/voice-agent/', keywords: 'voice agent auth booking defects evals' },
    { label: 'The migration rescue', group: 'case', icon: '02', href: '/career/migration/', keywords: 'migration routing contact centre test gate' },
    { label: 'Silent green', group: 'case', icon: '03', href: '/career/silent-green/', keywords: 'ai authoring evals testing lint' },
    { label: 'The prototype that lost', group: 'case', icon: '04', href: '/career/cloud-run/', keywords: 'cloud run gcp benchmarking ipaas' },
    { label: 'GitHub', group: 'link', icon: 'gh', href: 'https://github.com/Matheesan2113', keywords: 'code source repos' },
    { label: 'LinkedIn', group: 'link', icon: 'in', href: 'https://www.linkedin.com/in/matheesanm', keywords: 'work network' },
    { label: 'Instagram', group: 'link', icon: 'ig', href: 'https://www.instagram.com/matheesan_m', keywords: 'photos' },
    { label: 'Spotify', group: 'link', icon: 'sp', href: 'https://open.spotify.com/user/22rvhmytriuvutsre3m722uzq', keywords: 'music playlists dj crate' },
    { label: 'Copy this page link', group: 'action', icon: 'cp', action: copyLink, keywords: 'clipboard share url' },
    { label: 'Print résumé', group: 'action', icon: 'pr', action: () => { location.href = '/resume/?print=1'; }, keywords: 'pdf save' },
    { label: 'RSS feed', group: 'action', icon: 'rss', href: '/rss.xml', keywords: 'subscribe notes' },
  ];


  let filtered = items;
  let cursor = 0;

  const render = () => {
    list.replaceChildren();
    if (!filtered.length) {
      const li = document.createElement('li');
      li.className = 'palette-empty';
      li.textContent = 'no match — try “music”, “games”, “career”';
      list.append(li);
      return;
    }

    filtered.forEach((item, index) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'presentation');

      const el = document.createElement(item.href ? 'a' : 'button') as HTMLAnchorElement | HTMLButtonElement;
      el.className = 'palette-item';
      el.id = `palette-item-${index}`;
      el.setAttribute('role', 'option');
      el.setAttribute('aria-selected', String(index === cursor));
      if (item.href) {
        el.setAttribute('href', item.href);
        if (item.href.startsWith('http')) {
          el.setAttribute('target', '_blank');
          el.setAttribute('rel', 'noopener noreferrer');
        }
      } else {
        el.setAttribute('type', 'button');
      }

      const icon = document.createElement('span');
      icon.className = 'pi-icon';
      icon.textContent = item.icon;

      const label = document.createElement('span');
      label.className = 'pi-label';
      label.textContent = item.label;

      const group = document.createElement('span');
      group.className = 'pi-group';
      group.textContent = item.group;

      el.append(icon, label, group);
      el.addEventListener('click', () => {
        if (item.action) item.action();
        else setTimeout(close, 80);
      });
      el.addEventListener('mouseenter', () => {
        cursor = index;
        updateSelection();
      });

      li.append(el);
      list.append(li);
    });

    input.setAttribute('aria-activedescendant', `palette-item-${cursor}`);
  };

  const updateSelection = () => {
    list.querySelectorAll<HTMLElement>('.palette-item').forEach((el, index) => {
      el.setAttribute('aria-selected', String(index === cursor));
    });
    const active = list.querySelector<HTMLElement>(`#palette-item-${cursor}`);
    active?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', `palette-item-${cursor}`);
  };

  const filter = (query: string) => {
    const q = query.trim().toLowerCase();
    filtered = q
      ? items.filter((item) => `${item.label} ${item.group} ${item.keywords ?? ''}`.toLowerCase().includes(q))
      : items;
    cursor = 0;
    render();
  };

  const open = () => {
    if (dialog.open) return;
    input.value = '';
    filter('');
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => input.focus());
  };

  input.addEventListener('input', () => filter(input.value));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      cursor = Math.min(cursor + 1, filtered.length - 1);
      updateSelection();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      cursor = Math.max(cursor - 1, 0);
      updateSelection();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const item = filtered[cursor];
      if (!item) return;
      if (item.action) item.action();
      else if (item.href) {
        if (item.href.startsWith('http')) window.open(item.href, '_blank', 'noopener');
        else location.href = item.href;
        close();
      }
    }
  });

  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  dialog.addEventListener('close', () => {
    document.body.style.overflow = '';
    input.blur();
  });

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = target.matches('input, textarea, select, [contenteditable="true"]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    } else if (e.key === '/' && !typing && !dialog.open) {
      e.preventDefault();
      open();
    }
  });

  document.addEventListener('command-palette:open', open);
</script>
