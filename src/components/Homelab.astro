---
const cards = [
  {
    code: '[compute]',
    title: 'Local inference',
    body: 'Private GPU compute for local models, embeddings and speech-to-text. Prompts, audio and vectors stay on hardware I control.',
    tags: ['local models', 'private compute', 'no cloud'],
  },
  {
    code: '[vision]',
    title: 'Computer vision',
    body: 'A small local camera system for object detection. Feeds, footage and alerts stay on a segmented private network; none of it is published.',
    tags: ['local inference', 'private network', 'retention'],
  },
  {
    code: '[media]',
    title: 'Photo intelligence',
    body: 'A self-hosted photo library with local indexing. Originals stay on private storage; the index exists only to make the archive searchable.',
    tags: ['self-hosted', 'local indexing', 'private storage'],
  },
  {
    code: '[compute]',
    title: 'Virtualization',
    body: 'One hypervisor host runs isolated workloads with hardware passthrough. There is no public admin surface.',
    tags: ['isolation', 'passthrough', 'no public admin'],
  },
  {
    code: '[storage]',
    title: 'Backups',
    body: 'Separate volumes for media, personal files and VM backups. Restores are tested, not assumed.',
    tags: ['separate volumes', 'tested restores', 'private'],
  },
  {
    code: '[network]',
    title: 'Network & identity',
    body: 'Segmented network, single sign-on for internal services and a private remote-access path. The public attack surface is intentionally small.',
    tags: ['segmentation', 'SSO', 'private access', 'least privilege'],
  },
];

const specs = [
  { key: 'domain', value: 'public site only · private services are not advertised in DNS' },
  { key: 'remote', value: 'private access path · no public admin ports' },
  { key: 'models', value: 'local model + embedding stack · specifics private' },
  { key: 'vision', value: 'on-premises inference · no cloud upload' },
  { key: 'monitoring', value: 'local monitoring and alerting' },
  { key: 'secrets', value: 'self-hosted secret management' },
  { key: 'policy', value: 'least privilege · tested restores · minimal public surface' },
];
---

<section id="homelab">
  <div class="container">
    <p class="section-label">homelab</p>
    <h2 class="section-title">A production lab, <em>deliberately private</em>.</h2>
    <p class="section-deck">
      The homelab is where I test the ML I can’t put in production: local inference, computer vision,
      storage and a segmented private network. It is part curiosity, part skill-building — and
      deliberately light on the specifics that would make it a target map.
    </p>

    <div class="scope-panel">
      <div class="scope-head mono">
        <span>scope.txt</span>
        <span class="scope-status"><i aria-hidden="true"></i>public-safe</span>
      </div>
      <div class="scope-grid">
        <div><span class="scope-key mono">shared</span><strong>capabilities, lessons, outcomes</strong></div>
        <div><span class="scope-key mono">withheld</span><strong>hosts, addresses, ports</strong></div>
        <div><span class="scope-key mono">withheld</span><strong>versions, service map</strong></div>
        <div><span class="scope-key mono">posture</span><strong>least privilege, tested restores</strong></div>
      </div>
    </div>

    <div class="hl-grid">
      {cards.map((card) => (
        <article class="hl-card">
          <div class="hl-code mono">{card.code}</div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <div class="hl-tags">
            {card.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="spec-table">
      {specs.map((spec) => (
        <div class="spec-row">
          <span class="spec-key mono">{spec.key}</span>
          <span class="spec-value">{spec.value}</span>
        </div>
      ))}
    </div>

    <p class="hl-note mono">
      the lab is invite-only · accounts are created personally · <a href="#access">access →</a>
    </p>
  </div>
</section>

<style>
  #homelab { background: var(--bg2); }

  .scope-panel {
    border: 1px solid var(--line);
    background: #060b13;
    margin-bottom: 2rem;
  }

  .scope-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.52rem;
    letter-spacing: 0.06em;
    color: var(--text3);
  }

  .scope-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ok);
  }

  .scope-status i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }

  .scope-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .scope-grid > div {
    padding: 0.85rem 0.9rem;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .scope-grid > div:last-child { border-right: 0; }

  .scope-key {
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    color: var(--text3);
  }

  .scope-grid strong {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text2);
  }

  .hl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .hl-card {
    background: var(--bg);
    padding: 1.4rem 1.3rem;
    transition: background 0.25s;
  }

  .hl-card:hover { background: var(--bg2); }

  .hl-code {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }

  .hl-card h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text1);
    margin-bottom: 0.5rem;
  }

  .hl-card p {
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--text2);
  }

  .hl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.9rem;
  }

  .hl-tags span {
    font-family: var(--mono);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.15rem 0.35rem;
  }

  .spec-table {
    border: 1px solid var(--line);
    border-top: 0;
    margin-top: 0;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    border-bottom: 1px solid var(--line);
  }

  .spec-row:last-child { border-bottom: 0; }

  .spec-key {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    padding: 0.7rem 0.85rem;
    border-right: 1px solid var(--line);
    background: var(--bg2);
  }

  .spec-value {
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--text2);
    padding: 0.7rem 0.85rem;
  }

  .hl-note {
    margin-top: 1.2rem;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    color: var(--text3);
  }

  .hl-note a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--wave2); }

  @media (max-width: 960px) {
    .hl-grid { grid-template-columns: 1fr 1fr; }
    .scope-grid { grid-template-columns: 1fr 1fr; }
    .scope-grid > div:nth-child(2) { border-right: 0; }
    .scope-grid > div:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 620px) {
    .hl-grid { grid-template-columns: 1fr; }
    .scope-grid { grid-template-columns: 1fr; }
    .scope-grid > div { border-right: 0; border-bottom: 1px solid var(--line); }
    .scope-grid > div:last-child { border-bottom: 0; }
    .spec-row { grid-template-columns: 1fr; }
    .spec-key { border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>
