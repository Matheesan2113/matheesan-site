---
import { toolbox } from '../data/profile';
import EvalConsole from './EvalConsole.astro';
---

<section id="ml">
  <div class="container">
    <p class="section-label">ml lab</p>
    <h2 class="section-title">The model is the <em>easy part</em>.</h2>
    <p class="section-deck">
      Production systems taught me that intelligence is the demo; reliability is the job. The loop below
      is the part I actually build: models wrapped in constraints, tools, traces and evals that make
      failure visible before a caller finds it. The tools change; the loop stays.
    </p>

    <div class="ml-grid">
      <div class="pipeline-panel">
        <div class="panel-top">
          <span class="mono">agent_loop.yaml</span>
          <span class="panel-badge mono">production</span>
        </div>

        <div class="pipeline">
          <div class="pipe-node">
            <span class="pipe-step mono">01 / input</span>
            <h3>listen</h3>
            <p>telephony · ASR · barge-in</p>
            <span class="pipe-state mono">audio in</span>
          </div>
          <div class="pipe-link" aria-hidden="true"></div>
          <div class="pipe-node">
            <span class="pipe-step mono">02 / policy</span>
            <h3>decide</h3>
            <p>LLM intent + deterministic guards</p>
            <span class="pipe-state mono">state machine</span>
          </div>
          <div class="pipe-link" aria-hidden="true"></div>
          <div class="pipe-node">
            <span class="pipe-step mono">03 / tools</span>
            <h3>act</h3>
            <p>APIs · idempotency · auth</p>
            <span class="pipe-state mono">side effects</span>
          </div>
          <div class="pipe-link" aria-hidden="true"></div>
          <div class="pipe-node">
            <span class="pipe-step mono">04 / oracle</span>
            <h3>verify</h3>
            <p>evals · traces · must / must-not</p>
            <span class="pipe-state mono">evidence out</span>
          </div>
        </div>

        <div class="pipeline-foot mono">
          <span>input: a real call</span>
          <span class="loop-note">loop: verify feeds the next release</span>
          <span>output: action + trace</span>
        </div>
      </div>

      <div class="ml-side">
        <div class="toolbox">
          {toolbox.map((group) => (
            <div class="tool-group">
              <p class="tool-label mono">{group.label}</p>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>

        <div class="adoption">
          <p class="mini-label mono">// ai adoption</p>
          <ul class="adoption-list">
            <li><span class="mono">2023</span> GitHub Copilot — team talks</li>
            <li><span class="mono">2024</span> Cursor — engineering offsite + workshop</li>
            <li><span class="mono">2026</span> Claude Code — memory patterns</li>
          </ul>
          <p class="adoption-note">“One of our most AI-forward engineers.” — manager’s farewell</p>
        </div>
      </div>
    </div>

    <div class="ml-lower">
      <EvalConsole />

      <div class="model-card">
        <div class="model-head">
          <span class="mono">model_card.md</span>
          <span class="mono model-local">local</span>
        </div>
        <dl>
          <div><dt>model</dt><dd>matheesan-1</dd></div>
          <div><dt>context</dt><dd>7 years AI/ML + production systems</dd></div>
          <div><dt>strengths</dt><dd>evals · debugging · AI-native delivery</dd></div>
          <div><dt>limits</dt><dd>will rewrite your test suite; says “it depends” when it does</dd></div>
          <div><dt>status</dt><dd class="model-open">building at WayTrade</dd></div>
        </dl>
        <p class="model-foot mono">
          currently: marketplace platforms at WayTrade · local inference on private hardware · MCP servers · evals for AI-authored config
        </p>
      </div>
    </div>

    <blockquote class="ml-quote">
      <p>“Put deterministic logic where correctness matters. Put LLMs where judgment helps.”</p>
      <cite class="mono">— the rule I keep relearning</cite>
    </blockquote>
  </div>
</section>

<style>
  #ml {
    position: relative;
    background: var(--bg);
  }

  #ml::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(28, 47, 73, 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgba(28, 47, 73, 0.22) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 65% at 50% 40%, black, transparent 75%);
    pointer-events: none;
  }

  #ml > .container { position: relative; z-index: 1; }

  .ml-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 1.5rem;
  }

  .pipeline-panel {
    border: 1px solid var(--line);
    background: rgba(7, 13, 22, 0.78);
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .panel-top, .model-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--text3);
  }

  .panel-badge {
    color: var(--ok);
    border: 1px solid rgba(126, 224, 184, 0.25);
    padding: 0.12rem 0.35rem;
    font-size: 0.5rem;
  }

  .pipeline {
    flex: 1;
    display: flex;
    align-items: stretch;
    padding: 1rem 0.85rem;
    gap: 0;
  }

  .pipe-node {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--line);
    background: linear-gradient(160deg, rgba(14, 24, 40, 0.9), rgba(7, 12, 20, 0.85));
    padding: 0.8rem 0.7rem 0.7rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s, transform 0.25s;
  }

  .pipe-node:hover { border-color: var(--wave2); transform: translateY(-2px); }

  .pipe-step {
    font-size: 0.48rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    margin-bottom: 0.5rem;
  }

  .pipe-node h3 {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1;
    color: var(--moon);
    margin-bottom: 0.4rem;
  }

  .pipe-node p {
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--text2);
    flex: 1;
  }

  .pipe-state {
    margin-top: 0.7rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
    font-size: 0.48rem;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .pipe-link {
    width: 22px;
    flex: 0 0 22px;
    position: relative;
  }

  .pipe-link::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 4px;
    right: 7px;
    height: 1px;
    background: var(--accent);
    opacity: 0.45;
  }

  .pipe-link::after {
    content: '›';
    position: absolute;
    right: 2px;
    top: 50%;
    transform: translateY(-54%);
    font-family: var(--mono);
    font-size: 0.95rem;
    color: var(--accent2);
  }

  .pipeline-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.55rem 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 0.48rem;
    letter-spacing: 0.05em;
    color: var(--text3);
  }

  .loop-note { color: var(--accent); }

  .ml-side { display: flex; flex-direction: column; gap: 1.5rem; }

  .toolbox {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    flex: 1;
  }

  .tool-group {
    background: rgba(7, 13, 22, 0.78);
    padding: 0.85rem 0.8rem;
  }

  .tool-label {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.55rem;
  }

  .tool-group ul { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }

  .tool-group li {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text2);
    padding-left: 0.6rem;
    position: relative;
  }

  .tool-group li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--wave2);
  }

  .adoption {
    border: 1px solid var(--line);
    background: rgba(7, 13, 22, 0.78);
    padding: 0.85rem 0.9rem;
  }

  .mini-label {
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    color: var(--text3);
    margin-bottom: 0.6rem;
  }

  .adoption-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }

  .adoption-list li {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text2);
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  .adoption-list .mono { color: var(--gold); font-size: 0.55rem; flex-shrink: 0; }

  .adoption-note {
    margin-top: 0.7rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--line);
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text3);
  }

  .ml-lower {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .model-card {
    border: 1px solid var(--line);
    background: rgba(7, 13, 22, 0.78);
    display: flex;
    flex-direction: column;
  }

  .model-local { color: var(--gold); }

  .model-card dl { padding: 0.8rem 0.9rem; flex: 1; }

  .model-card dl > div {
    display: grid;
    grid-template-columns: 4.8rem 1fr;
    gap: 0.6rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid rgba(28, 47, 73, 0.55);
  }

  .model-card dl > div:last-child { border-bottom: 0; }

  .model-card dt {
    font-family: var(--mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text3);
    padding-top: 0.15rem;
  }

  .model-card dd {
    font-family: var(--mono);
    font-size: 0.66rem;
    line-height: 1.5;
    color: var(--text2);
  }

  .model-card dd.model-open { color: var(--ok); }

  .model-foot {
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.5rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: var(--text3);
  }

  .ml-quote {
    margin: 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ml-quote p {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--moon);
    max-width: 780px;
  }

  .ml-quote cite {
    font-style: normal;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--text3);
  }

  @media (max-width: 1000px) {
    .ml-grid, .ml-lower { grid-template-columns: 1fr; }
    .pipeline { flex-wrap: wrap; }
    .pipe-link { display: none; }
    .pipe-node { flex: 1 1 45%; }
  }

  @media (max-width: 620px) {
    .pipeline { flex-direction: column; gap: 0.5rem; }
    .pipe-node { flex: 1 1 auto; }
    .pipeline-foot { flex-direction: column; gap: 0.25rem; }
    .toolbox { grid-template-columns: 1fr; }
    .model-card dl > div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
