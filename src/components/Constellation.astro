<canvas id="constellation" aria-hidden="true"></canvas>

<style>
  #constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.7;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('constellation') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  const hero = document.getElementById('hero');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (canvas && ctx && hero) {
    let width = 0;
    let height = 0;
    let raf = 0;
    let visible = true;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    const mouse = { x: -9999, y: -9999, active: false };
    type Point = { x: number; y: number; vx: number; vy: number; r: number; phase: number };
    let points: Point[] = [];

    const makePoints = () => {
      const count = width < 700 ? 26 : 62;
      points = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: 0.6 + Math.random() * 1.2,
        phase: Math.random() * Math.PI * 2,
      }));
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      makePoints();
      if (reduced) draw(0);
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, width, height);
      const maxDist = width < 700 ? 92 : 122;

      for (const point of points) {
        if (!reduced) {
          point.x += point.vx;
          point.y += point.vy;
          if (point.x < -10) point.x = width + 10;
          if (point.x > width + 10) point.x = -10;
          if (point.y < -10) point.y = height + 10;
          if (point.y > height + 10) point.y = -10;

          if (mouse.active) {
            const dx = mouse.x - point.x;
            const dy = mouse.y - point.y;
            const dist = Math.hypot(dx, dy);
            if (dist < 150 && dist > 0.1) {
              const pull = (1 - dist / 150) * 0.012;
              point.vx += (dx / dist) * pull;
              point.vy += (dy / dist) * pull;
            }
          }

          point.vx *= 0.995;
          point.vy *= 0.995;
          const speed = Math.hypot(point.vx, point.vy);
          if (speed < 0.03) {
            point.vx += (Math.random() - 0.5) * 0.02;
            point.vy += (Math.random() - 0.5) * 0.02;
          }
        }
      }

      for (let i = 0; i < points.length; i++) {
        for (let j = i + 1; j < points.length; j++) {
          const a = points[i];
          const b = points[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist > maxDist) continue;
          const alpha = (1 - dist / maxDist) * 0.18;
          ctx.strokeStyle = `rgba(88, 174, 201, ${alpha})`;
          ctx.lineWidth = 0.6;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      for (const point of points) {
        const twinkle = 0.55 + Math.sin(t * 0.001 + point.phase) * 0.25;
        ctx.beginPath();
        ctx.fillStyle = `rgba(211, 224, 244, ${twinkle})`;
        ctx.arc(point.x, point.y, point.r, 0, Math.PI * 2);
        ctx.fill();
      }

      if (mouse.active) {
        for (const point of points) {
          const dist = Math.hypot(point.x - mouse.x, point.y - mouse.y);
          if (dist > 170) continue;
          const alpha = (1 - dist / 170) * 0.22;
          ctx.strokeStyle = `rgba(201, 169, 110, ${alpha})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(mouse.x, mouse.y);
          ctx.lineTo(point.x, point.y);
          ctx.stroke();
        }
      }
    };

    const loop = (t: number) => {
      draw(t);
      if (!reduced && visible) raf = requestAnimationFrame(loop);
    };

    if (fine) {
      hero.addEventListener('pointermove', (e) => {
        const rect = hero.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
      });
      hero.addEventListener('pointerleave', () => { mouse.active = false; });
    }

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !reduced) {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(loop);
      }
    }, { threshold: 0 }).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else if (!reduced && visible) raf = requestAnimationFrame(loop);
    });

    resize();
    window.addEventListener('resize', resize);
    if (reduced) draw(0);
    else raf = requestAnimationFrame(loop);
  }
</script>
