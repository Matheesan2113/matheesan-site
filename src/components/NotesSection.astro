---
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<section id="notes">
  <div class="container">
    <p class="section-label">// transmissions</p>
    <h2 class="section-title">Things I keep <em>relearning</em>.</h2>
    <p class="section-deck">
      Notes from production AI, testing and systems work. Mostly written so I stop relearning the same
      lesson — and in case they save someone else a day.
    </p>

    <div class="notes-list">
      {notes.map((note, index) => (
        <a class="note-row" href={`/notes/${note.id}/`}>
          <span class="note-num mono">0{index + 1}</span>
          <span class="note-main">
            <span class="note-meta mono">{fmt(note.data.date)} · {note.data.reading} read</span>
            <span class="note-title">{note.data.title}</span>
            <span class="note-desc">{note.data.description}</span>
            <span class="note-tags">
              {note.data.tags.map((tag) => <span>{tag}</span>)}
            </span>
          </span>
          <span class="note-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <div class="notes-foot">
      <a href="/notes/" class="btn-ghost btn-small">all field notes <span aria-hidden="true">→</span></a>
      <a href="/rss.xml" class="rss-link mono">rss <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  #notes { background: var(--bg); }

  .notes-list { border-top: 1px solid var(--line); }

  .note-row {
    display: grid;
    grid-template-columns: 52px 1fr 24px;
    gap: 1.2rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.2s;
  }

  .note-row:hover { background: rgba(14, 24, 40, 0.45); }

  .note-num {
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    padding-top: 0.25rem;
  }

  .note-main { display: flex; flex-direction: column; gap: 0.3rem; }

  .note-meta {
    font-size: 0.53rem;
    letter-spacing: 0.08em;
    color: var(--text3);
  }

  .note-title {
    font-family: var(--serif);
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text1);
    transition: color 0.2s;
  }

  .note-row:hover .note-title { color: var(--accent2); }

  .note-desc {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--text2);
    max-width: 720px;
  }

  .note-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.35rem; }

  .note-tags span {
    font-family: var(--mono);
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.12rem 0.35rem;
  }

  .note-arrow {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--text3);
    padding-top: 0.3rem;
    transition: color 0.2s, transform 0.2s;
  }

  .note-row:hover .note-arrow { color: var(--accent); transform: translateX(4px); }

  .notes-foot {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  .rss-link {
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--text3);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .rss-link:hover { color: var(--accent); border-bottom-color: var(--wave2); }

  @media (max-width: 620px) {
    .note-row { grid-template-columns: 32px 1fr 16px; gap: 0.7rem; }
    .note-title { font-size: 1.35rem; }
    .note-desc { font-size: 0.8rem; }
  }
</style>
