---
import { site } from '../data/profile';
import Constellation from './Constellation.astro';
---

<section id="hero">
  <Constellation />

  <canvas id="wave-canvas" aria-hidden="true"></canvas>

  <svg class="dragon-bg" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M20,220 C60,180 80,120 140,100 C180,86 200,110 240,90 C280,70 300,40 340,30 C360,24 380,28 390,20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M140,100 C130,80 120,60 100,50 C90,45 80,50 75,60" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
    <path d="M240,90 C250,70 260,50 270,40" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
    <path d="M240,90 C255,100 265,115 260,130" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
    <circle cx="95" cy="44" r="3.4" fill="currentColor" opacity="0.7"/>
    <path d="M20,220 C10,240 8,260 15,270 C22,280 40,275 50,260" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/>
    <path d="M20,220 C30,235 28,255 20,265" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
  </svg>

  <div class="moon-container" aria-hidden="true">
    <div class="moon-halo"></div>
    <div class="moon-ring"></div>
    <div class="moon"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-main">
      <p class="hero-path">
        <span class="hero-prompt">~</span><span class="hero-sep">/</span>matheesan.ca
        <span class="hero-caret" aria-hidden="true"></span>
      </p>

      <p class="hero-status"><span class="status-dot" aria-hidden="true"></span>{site.personalStatus}</p>

      <h1 class="hero-name">Mathe<em>esan</em><span class="hero-dot">.</span></h1>

      <p class="hero-headline">{site.positioning}</p>
      <p class="hero-sub">{site.intro}</p>

      <div class="hero-tags" aria-label="Things I’m into">
        <span class="tag">Tamil-Canadian</span>
        <span class="tag">DJ</span>
        <span class="tag">Elden Ring</span>
        <span class="tag">Wukong</span>
        <span class="tag">Mario Kart</span>
        <span class="tag">Valorant</span>
        <span class="tag">Overwatch</span>
      </div>

      <div class="hero-cta">
        <a href="/music/" class="btn-primary">hear the mix <span aria-hidden="true">→</span></a>
        <a href="/games/" class="btn-ghost">see the rotation <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="At a glance">
      <div class="panel-head">
        <span>matheesan://life</span>
        <span class="panel-live"><i aria-hidden="true"></i>online</span>
      </div>

      <dl class="panel-list">
        <div><dt>role</dt><dd>engineer · dj · gamer</dd></div>
        <div><dt>focus</dt><dd>systems · sound · games</dd></div>
        <div><dt>base</dt><dd>markham, on</dd></div>
        <div><dt>local</dt><dd id="local-time">--:--</dd></div>
        <div><dt>state</dt><dd class="panel-ok">currently: evals · a new mix · wukong</dd></div>
      </dl>

      <div class="panel-meter" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      <p class="panel-foot">
        <span>moon name</span>
        <span>dragon year</span>
        <span>wave country</span>
      </p>
    </aside>
  </div>

  <div class="hero-meta">
    <span class="mono">{site.coords}</span>
    <span class="hero-scroll"><span class="scroll-line" aria-hidden="true"></span>scroll to explore</span>
    <span class="mono">v2026.11</span>
  </div>
</section>

<style>
  #hero {
    --px: 0;
    --py: 0;
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 7rem 0 5rem;
    background:
      radial-gradient(ellipse 55% 45% at 78% 18%, rgba(40, 82, 130, 0.18), transparent 70%),
      radial-gradient(ellipse 45% 40% at 15% 75%, rgba(27, 58, 92, 0.16), transparent 70%),
      var(--bg);
  }

  #wave-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.52;
    pointer-events: none;
  }

  .dragon-bg {
    position: absolute;
    left: -3%;
    transform: translate(calc(var(--px) * -10px), calc(var(--py) * -8px));
    transition: transform 0.3s ease-out;
    top: 16%;
    width: 380px;
    color: var(--moon);
    opacity: 0.05;
    pointer-events: none;
  }

  .moon-container {
    position: absolute;
    transform: translate(calc(var(--px) * 16px), calc(var(--py) * 12px));
    transition: transform 0.3s ease-out;
    top: 10%;
    right: 6%;
    width: 260px;
    height: 260px;
    z-index: 0;
    pointer-events: none;
  }

  .moon {
    position: absolute;
    inset: 60px;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 34%, #eef4ff 0%, #b8cee9 28%, #6f96c2 58%, #1a2a4a 100%);
    box-shadow:
      0 0 40px 12px rgba(127, 168, 212, 0.13),
      0 0 90px 36px rgba(74, 120, 180, 0.08);
    animation: moonFloat 9s ease-in-out infinite;
  }

  .moon-halo {
    position: absolute;
    inset: 22px;
    border-radius: 50%;
    border: 1px solid rgba(127, 168, 212, 0.1);
  }

  .moon-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(88, 174, 201, 0.1);
    animation: sonar 7s ease-out infinite;
  }

  @keyframes moonFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }

  @keyframes sonar {
    0%   { transform: scale(0.82); opacity: 0; }
    35%  { opacity: 0.7; }
    100% { transform: scale(1.18); opacity: 0; }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 4rem;
    align-items: center;
  }

  .hero-main { max-width: 700px; }

  .hero-path {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--text3);
    margin-bottom: 1.6rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-prompt { color: var(--accent); }
  .hero-sep { color: var(--text3); }

  .hero-caret {
    width: 7px;
    height: 13px;
    background: var(--accent);
    display: inline-block;
    margin-left: 0.3rem;
    animation: blink 1.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--ok);
    border: 1px solid rgba(126, 224, 184, 0.22);
    background: rgba(126, 224, 184, 0.04);
    padding: 0.35rem 0.65rem;
    margin-bottom: 1.2rem;
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 rgba(126, 224, 184, 0.5);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(126, 224, 184, 0.4); }
    70%  { box-shadow: 0 0 0 7px rgba(126, 224, 184, 0); }
    100% { box-shadow: 0 0 0 0 rgba(126, 224, 184, 0); }
  }

  .hero-name {
    font-family: var(--serif);
    font-size: clamp(4.2rem, 8.5vw, 7.2rem);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: var(--text1);
    margin-bottom: 1.4rem;
  }

  .hero-name em {
    font-style: italic;
    color: var(--moon2);
  }

  .hero-dot { color: var(--gold); }

  .hero-headline {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 300;
    line-height: 1.28;
    color: var(--moon);
    max-width: 580px;
    margin-bottom: 1.2rem;
  }

  .hero-sub {
    font-size: 0.98rem;
    line-height: 1.75;
    color: var(--text2);
    max-width: 560px;
    margin-bottom: 1.7rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--text2);
    border: 1px solid var(--line);
    padding: 0.28rem 0.6rem;
    transition: border-color 0.2s, color 0.2s;
  }

  .tag:hover { border-color: var(--wave2); color: var(--moon); }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-panel {
    position: relative;
    transform: translate(calc(var(--px) * -5px), calc(var(--py) * -4px));
    transition: transform 0.3s ease-out, border-color 0.3s;
    border: 1px solid rgba(88, 174, 201, 0.22);
    background: linear-gradient(160deg, rgba(14, 24, 40, 0.82), rgba(7, 12, 20, 0.72));
    backdrop-filter: blur(8px);
    padding: 1.1rem 1.2rem 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.28);
  }

  .hero-panel::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 34px;
    height: 1px;
    background: var(--accent);
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--text3);
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .panel-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ok);
  }

  .panel-live i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
  }

  .panel-list { margin: 0.7rem 0 0.9rem; }

  .panel-list > div {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.6rem;
    padding: 0.38rem 0;
    border-bottom: 1px solid rgba(28, 47, 73, 0.45);
  }

  .panel-list > div:last-child { border-bottom: 0; }

  .panel-list dt {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    text-transform: uppercase;
  }

  .panel-list dd {
    font-family: var(--mono);
    font-size: 0.65rem;
    line-height: 1.5;
    color: var(--text2);
    overflow-wrap: anywhere;
  }

  .panel-list dd.panel-ok { color: var(--ok); }

  .panel-meter {
    display: flex;
    gap: 3px;
    align-items: flex-end;
    height: 22px;
    margin-bottom: 0.8rem;
  }

  .panel-meter span {
    display: block;
    width: 100%;
    background: linear-gradient(to top, rgba(88, 174, 201, 0.15), rgba(88, 174, 201, 0.7));
    animation: meter 2.8s ease-in-out infinite alternate;
    transform-origin: bottom;
  }

  .panel-meter span:nth-child(1) { height: 34%; animation-delay: 0s; }
  .panel-meter span:nth-child(2) { height: 62%; animation-delay: 0.2s; }
  .panel-meter span:nth-child(3) { height: 45%; animation-delay: 0.4s; }
  .panel-meter span:nth-child(4) { height: 88%; animation-delay: 0.6s; }
  .panel-meter span:nth-child(5) { height: 54%; animation-delay: 0.8s; }
  .panel-meter span:nth-child(6) { height: 72%; animation-delay: 1s; }
  .panel-meter span:nth-child(7) { height: 38%; animation-delay: 1.2s; }
  .panel-meter span:nth-child(8) { height: 60%; animation-delay: 1.4s; }

  @keyframes meter {
    from { transform: scaleY(0.45); opacity: 0.5; }
    to   { transform: scaleY(1); opacity: 1; }
  }

  .panel-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--text3);
    border-top: 1px solid var(--line);
    padding-top: 0.65rem;
  }

  .hero-meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.6rem;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0 2rem;
    color: var(--text3);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    pointer-events: none;
  }

  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text3);
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
  }

  .scroll-line {
    width: 44px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--accent));
    animation: scrollPulse 2.4s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.25; transform: scaleX(0.7); transform-origin: left; }
    50%      { opacity: 0.9; transform: scaleX(1); transform-origin: left; }
  }

  @media (max-width: 960px) {
    #hero { padding-top: 6.5rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.4rem; }
    .moon-container { width: 180px; height: 180px; top: 8%; right: 2%; opacity: 0.7; }
    .moon { inset: 42px; }
    .hero-panel { max-width: 460px; }
    .dragon-bg { width: 280px; opacity: 0.04; }
  }

  @media (max-width: 600px) {
    #hero { padding: 5.8rem 0 4.5rem; min-height: auto; }
    .hero-name { font-size: clamp(3.4rem, 16vw, 5rem); }
    .hero-headline { font-size: 1.45rem; }
    .hero-meta { display: none; }
    .moon-container { width: 120px; height: 120px; top: 5%; right: -2%; opacity: 0.5; }
    .moon { inset: 28px; }
    .hero-panel { padding: 0.9rem 1rem; }
    .hero-cta .btn-primary, .hero-cta .btn-ghost { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .moon, .moon-ring, .panel-meter span, .status-dot, .hero-caret, .scroll-line { animation: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .moon-container, .hero-panel, .dragon-bg { transform: none !important; }
  }
</style>



<script>
  const timeEl = document.getElementById('local-time');
  if (timeEl) {
    const fmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Toronto',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => { timeEl.textContent = `${fmt.format(new Date())} et`; };
    tick();
    setInterval(tick, 30_000);
  }

  const canvas = document.getElementById('wave-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && ctx) {
    let t = 0;
    let raf = 0;
    let visible = true;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const waves = [
      { a: 42, f: 0.007, s: 0.009, y: 0.52, c: 'rgba(27,58,92,0.55)', w: 1.5 },
      { a: 30, f: 0.011, s: 0.014, y: 0.60, c: 'rgba(74,158,187,0.28)', w: 1 },
      { a: 55, f: 0.005, s: 0.007, y: 0.70, c: 'rgba(27,58,92,0.38)', w: 2 },
      { a: 20, f: 0.016, s: 0.020, y: 0.42, c: 'rgba(127,168,212,0.15)', w: 0.8 },
      { a: 35, f: 0.009, s: 0.011, y: 0.80, c: 'rgba(30,77,122,0.25)', w: 1.2 },
    ];

    const resize = () => {
      canvas.width = Math.floor(canvas.offsetWidth * dpr);
      canvas.height = Math.floor(canvas.offsetHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      const w = canvas.width / dpr;
      const h = canvas.height / dpr;
      ctx.clearRect(0, 0, w, h);
      for (const wave of waves) {
        ctx.beginPath();
        ctx.strokeStyle = wave.c;
        ctx.lineWidth = wave.w;
        for (let x = 0; x <= w; x += 2) {
          const y = h * wave.y + Math.sin(x * wave.f + t * wave.s * 60) * wave.a;
          x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      t += 0.016;
      if (!reduced && visible) raf = requestAnimationFrame(draw);
    };

    resize();
    draw();
    window.addEventListener('resize', () => { resize(); if (reduced) draw(); });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !reduced) {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(draw);
      }
    }, { threshold: 0 }).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else if (!reduced) raf = requestAnimationFrame(draw);
    });
  }

  const heroEl = document.getElementById('hero');
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  if (heroEl && finePointer && !reduced) {
    let parallaxFrame = 0;
    let px = 0;
    let py = 0;
    const applyParallax = () => {
      heroEl.style.setProperty('--px', px.toFixed(3));
      heroEl.style.setProperty('--py', py.toFixed(3));
      parallaxFrame = 0;
    };
    heroEl.addEventListener('pointermove', (e) => {
      const rect = heroEl.getBoundingClientRect();
      px = (e.clientX - rect.left) / rect.width - 0.5;
      py = (e.clientY - rect.top) / rect.height - 0.5;
      if (!parallaxFrame) parallaxFrame = requestAnimationFrame(applyParallax);
    });
    heroEl.addEventListener('pointerleave', () => {
      px = 0;
      py = 0;
      if (!parallaxFrame) parallaxFrame = requestAnimationFrame(applyParallax);
    });
  }

</script>
