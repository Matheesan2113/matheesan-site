---
import { jobs, careerStats } from '../data/profile';
---

<div class="work-timeline">
  <div class="exp-stats" aria-label="Career timeline">
    {careerStats.map((stat) => (
      <div class="exp-stat">
        <span class="exp-stat-value">{stat.value}</span>
        <span class="exp-stat-label">{stat.label}</span>
        <span class="exp-stat-note">{stat.note}</span>
      </div>
    ))}
  </div>

  <p class="exp-breadth">
    The agents are the visible artifact. The job was still software engineering: API reviews, state
    machines, integrations, infra, tests, release trains, incident response — and choosing the tooling
    that made each loop shorter.
    <a href="/tooling/">see the tooling timeline <span aria-hidden="true">→</span></a>
  </p>

  <div class="jobs">
    {jobs.map((job, index) => (
      <article class:list={['job', { 'job-current': index === 0 }]}>
        <div class="job-meta">
          <span class="job-period mono">{job.period}</span>
          <span class="job-place mono">{job.place}</span>
        </div>

        <div class="job-main">
          <div class="job-title-row">
            <h2 class="job-role">{job.role}</h2>
            {index === 0 && <span class="job-badge mono">most recent</span>}
          </div>
          <p class="job-company">{job.company}</p>
          <p class="job-summary">{job.summary}</p>

          {job.highlights.length > 0 && (
            <ul class="job-highlights">
              {job.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          )}

          <div class="job-stack">
            {job.stack.map((tech) => <span>{tech}</span>)}
          </div>

          {job.award && <p class="job-award mono">recognised · {job.award}</p>}
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .exp-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 3.5rem;
  }

  .exp-stat {
    background: var(--bg2);
    padding: 1.1rem 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exp-stat-value {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--moon);
  }

  .exp-stat-label {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--text2);
  }

  .exp-stat-note { font-size: 0.62rem; color: var(--text3); }

  .exp-breadth {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    border-left: 2px solid var(--wave2);
    padding: 0.5rem 0 0.5rem 1rem;
    margin-bottom: 2.2rem;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text2);
  }

  .exp-breadth a {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    white-space: nowrap;
  }

  .exp-breadth a:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  .jobs { border-top: 1px solid var(--line); }

  .job {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 2.5rem;
    padding: 2.2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.25rem;
  }

  .job-period { font-size: 0.66rem; color: var(--moon2); letter-spacing: 0.04em; }
  .job-place { font-size: 0.58rem; color: var(--text3); }

  .job-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }

  .job-role {
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text1);
  }

  .job-badge {
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    color: var(--ok);
    border: 1px solid rgba(126, 224, 184, 0.3);
    padding: 0.15rem 0.4rem;
  }

  .job-company {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 0.8rem;
  }

  .job-summary {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text2);
    max-width: 760px;
  }

  .job-highlights {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-width: 800px;
  }

  .job-highlights li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--text2);
  }

  .job-highlights li::before {
    content: '•';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--wave2);
    font-size: 0.8rem;
  }

  .job-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .job-stack span {
    font-family: var(--mono);
    font-size: 0.55rem;
    letter-spacing: 0.05em;
    color: var(--text3);
    border: 1px solid var(--line);
    padding: 0.2rem 0.45rem;
  }

  .job-award {
    margin-top: 0.9rem;
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    color: var(--gold);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .exp-stats { grid-template-columns: 1fr 1fr; }
    .exp-breadth { flex-direction: column; gap: 0.6rem; }
    .job { grid-template-columns: 1fr; gap: 0.8rem; }
    .job-meta { flex-direction: row; gap: 1rem; }
  }

  @media (max-width: 620px) {
    .exp-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
