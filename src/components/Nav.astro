    </ul>
    <a href="/career/" class="nav-secondary" data-nav="career">career</a>
    <a href="/resume/" class="nav-secondary" data-nav="resume">résumé</a>
    <button class="nav-kbd" type="button" data-command-open aria-label="Open command palette">
      <kbd>ctrl</kbd><kbd>K</kbd>
    </button>
    <a href="/contact/" class="nav-cta">contact <span aria-hidden="true">↗</span></a>
