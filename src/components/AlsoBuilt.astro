---
import { alsoBuilt } from '../data/profile';
---

<div class="also-built">
  <p class="also-label mono">// also built</p>
  <ul>
    {alsoBuilt.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .also-built {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .also-label {
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--text3);
  }

  .also-built ul {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.6rem;
  }

  .also-built li {
    position: relative;
    padding-left: 0.9rem;
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--text2);
  }

  .also-built li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--wave2);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  @media (max-width: 760px) {
    .also-built { grid-template-columns: 1fr; gap: 0.8rem; }
    .also-built ul { grid-template-columns: 1fr; }
  }
</style>
