---
const identities = [
  'Tamil-Canadian',
  'Born Toronto, raised Markham',
  'Tamil · English · French',
  'DJ · after hours',
  'Elden Ring · Wukong',
];
---

<section id="about">
  <div class="container">
    <div class="about-teaser">
      <div class="about-symbol" aria-hidden="true">M<span>.</span></div>

      <div class="about-copy">
        <p class="section-label">about</p>
        <h2 class="section-title">The longer <em>version</em>.</h2>
        <p class="about-bio">
          Matheesan first. Tamil-Canadian, born in Toronto and raised in Markham. Engineer, DJ,
          gamer. I care about systems that work, transitions that land, and the gap between a green
          suite and a real call.
        </p>
        <div class="about-identities">
          {identities.map((identity) => (
            <span class="identity"><i aria-hidden="true"></i>{identity}</span>
          ))}
        </div>
        <a href="/about/" class="section-link mono">read the full about <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  #about { background: var(--bg2); }

  .about-teaser {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 3rem;
    align-items: center;
  }

  .about-symbol {
    font-family: var(--serif);
    font-size: clamp(6rem, 10vw, 10rem);
    font-style: italic;
    line-height: 0.8;
    color: var(--wave1);
  }

  .about-symbol span { color: var(--gold); }

  .about-bio {
    font-family: var(--serif);
    font-size: 1.18rem;
    line-height: 1.85;
    color: var(--text2);
    max-width: 700px;
    margin-bottom: 1.4rem;
  }

  .about-identities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-bottom: 1.5rem;
  }

  .identity {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--text2);
  }

  .identity i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  .section-link {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.15rem;
  }

  .section-link:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  @media (max-width: 760px) {
    .about-teaser { grid-template-columns: 1fr; gap: 1.5rem; }
    .about-symbol { font-size: 5rem; }
  }
</style>
