---
type LifeBlock = {
  label: string;
  title: string;
  body: string;
  tags: string[];
  href?: string;
};

const blocks: LifeBlock[] = [
  {
    label: 'travel',
    title: '2–4 trips a year, always',
    body:
      'Japan twice, Sri Lanka twice, Mexico six times, France, Switzerland, England, Singapore, Malaysia, Colombia. Vancouver and Montreal regularly. I try to eat at a Michelin-starred restaurant on most trips — food is how I understand a place.',
    tags: ['Japan ×2', 'Sri Lanka ×2', 'Mexico ×6', 'France', 'Switzerland', 'England', 'Singapore', 'Malaysia', 'Colombia', 'Vancouver', 'Montreal'],
  },
  {
    label: 'music / DJ',
    title: 'The other kind of mixing',
    body:
      'I DJ — basshall and dancehall, South Indian, R&B, gaming OSTs, whatever the room needs. A clean transition and a clean API scratch the same itch: read the room, set up the next move, don’t over-explain the drop.',
    tags: ['basshall', 'dancehall', 'South Indian', 'R&B', 'gaming OSTs'],
    href: '/music/',
  },
  {
    label: 'games',
    title: 'Boss fights & party games',
    body:
      'Elden Ring is the benchmark, Wukong is the current wall, Mario Kart is the comfort game, Valorant is the aim trainer and Overwatch is the team fight. Not ranked — just the rotation.',
    tags: ['Elden Ring', 'Wukong', 'Mario Kart', 'Valorant', 'Overwatch'],
    href: '/games/',
  },
  {
    label: 'food',
    title: 'Asian cuisine, Michelin stars, everything',
    body:
      'Growing up between Scarborough and Markham meant exposure to every Asian cuisine imaginable from a young age. Tamil home cooking, Japanese ramen, Chinese dim sum, Korean BBQ — all normal. I’ll splurge on a great meal. Some experiences are worth the price.',
    tags: [],
  },
];
---

<section id="life">
  <div class="container">
    <p class="section-label">life</p>
    <h2 class="section-title">Beyond the <em>keyboard</em>.</h2>
    <p class="section-deck">
      The work is better when the rest of life is full. Travel, food, music, games — the same curiosity,
      pointed somewhere other than a terminal.
    </p>

    <div class="life-grid">
      {blocks.map((block, index) => (
        <article class:list={['interest', { 'interest-wide': index === 0 }]}>
          <p class="interest-label mono">{block.label}</p>
          <h3 class="interest-title">{block.title}</h3>
          <p class="interest-body">{block.body}</p>
          {block.tags.length > 0 && (
            <div class="travel-list">
              {block.tags.map((tag) => <span>{tag}</span>)}
            </div>
          )}
          {block.href && (
            <a href={block.href} class="interest-link mono">explore <span aria-hidden="true">→</span></a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #life { background: var(--bg); }

  .life-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .interest {
    background: var(--bg2);
    padding: 1.8rem 1.7rem;
    transition: background 0.25s;
  }

  .interest:hover { background: var(--bg3); }

  .interest-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.12rem;
  }

  .interest-link:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  .interest-wide,
  .interest:last-child { grid-column: 1 / -1; }

  .interest-label {
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    color: var(--gold);
    margin-bottom: 0.55rem;
  }

  .interest-title {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--text1);
    margin-bottom: 0.7rem;
  }

  .interest-body {
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--text2);
    max-width: 760px;
  }

  .travel-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .travel-list span {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    color: var(--text2);
    border: 1px solid var(--line);
    padding: 0.25rem 0.55rem;
    transition: border-color 0.2s, color 0.2s;
  }

  .travel-list span:hover { color: var(--moon); border-color: var(--wave2); }

  @media (max-width: 780px) {
    .life-grid { grid-template-columns: 1fr; }
    .interest-wide, .interest:last-child { grid-column: auto; }
  }
</style>
