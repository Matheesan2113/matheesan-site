---
import type { MarginQuote } from '../../data/story';

interface Props {
  quote: MarginQuote;
  compact?: boolean;
}

const { quote, compact = false } = Astro.props;
---

<figure class:list={['quote', { 'quote-compact': compact }]} data-quote={quote.key}>
  <blockquote class="quote-text">
    {quote.lines.map((line) => <span class="quote-line">{line}</span>)}
  </blockquote>
  <figcaption class="quote-foot">
    <span class="quote-attr">
      — {quote.author}<span class="quote-work">, <cite>{quote.work}</cite></span>
    </span>
    {!compact && <p class="quote-note">{quote.note}</p>}
  </figcaption>
</figure>

<style>
  .quote {
    margin: 0;
    padding: 0;
  }

  .quote-text {
    margin: 0 0 1rem;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.45;
    color: var(--moon);
    text-wrap: balance;
  }

  .quote-line { display: block; }

  .quote-foot {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .quote-attr {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .quote-work {
    color: var(--text3);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .quote-note {
    font-size: 0.84rem;
    line-height: 1.7;
    color: var(--text2);
    max-width: 54ch;
  }

  .quote-compact .quote-text { font-size: 1.1rem; }
  .quote-compact .quote-attr { font-size: 0.55rem; }
</style>
