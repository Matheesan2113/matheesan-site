---
import { games } from '../data/profile';
---

<section id="rotation">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="section-label">games</p>
        <h2 class="section-title">Boss fights &amp; <em>party games</em>.</h2>
      </div>
      <a href="/games/" class="section-link mono">see the rotation <span aria-hidden="true">→</span></a>
    </div>

    <p class="section-deck rotation-deck">
      A soulslike, a monkey king, a blue-shell simulator, a tac shooter and a team fight. Not a ranking
      — just the five I keep coming back to.
    </p>

    <div class="game-strip">
      {games.map((game, index) => (
        <a class="game-card" href={`/games/#${game.id}`}>
          <span class="game-top mono"><span>0{index + 1}</span><span>{game.status}</span></span>
          <h3>{game.title}</h3>
          <p class="game-kind mono">{game.kind}</p>
          <span class="game-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  #rotation { background: var(--bg); }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .section-head .section-title { margin-bottom: 0; }

  .section-link {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }

  .section-link:hover { color: var(--accent2); border-bottom-color: var(--accent2); }

  .rotation-deck { max-width: 64ch; margin-bottom: 2rem; }

  .game-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .game-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 190px;
    padding: 1.1rem 1rem 1rem;
    background: var(--bg2);
    text-decoration: none;
    transition: background 0.25s;
  }

  .game-card:hover { background: var(--bg3); }

  .game-top {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    color: var(--text3);
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .game-top span:first-child { color: var(--accent); }

  .game-card h3 {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.15;
    color: var(--text1);
    margin-bottom: 0.35rem;
  }

  .game-kind { font-size: 0.52rem; color: var(--text3); letter-spacing: 0.04em; }

  .game-arrow {
    margin-top: auto;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.75rem;
    transition: transform 0.2s;
  }

  .game-card:hover .game-arrow { transform: translateX(4px); }

  @media (max-width: 1000px) {
    .game-strip { grid-template-columns: repeat(3, 1fr); }
    .game-card:nth-child(4), .game-card:nth-child(5) { min-height: 160px; }
  }

  @media (max-width: 700px) {
    .section-head { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .game-strip { grid-template-columns: 1fr 1fr; }
    .game-card { min-height: 150px; }
  }

  @media (max-width: 480px) {
    .game-strip { grid-template-columns: 1fr; }
    .game-card { min-height: 0; }
  }
</style>
