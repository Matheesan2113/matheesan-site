<div id="boot" class="boot" aria-hidden="true" hidden>
  <div class="boot-moon" aria-hidden="true"></div>
  <div class="boot-glow" aria-hidden="true"></div>
  <div class="boot-terminal">
    <div class="boot-bar">
      <span class="boot-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono">matheesan.ca — signal</span>
      <span class="mono boot-status">connecting</span>
    </div>
    <div class="boot-body">
      <p class="boot-line" style="--i: 1"><span class="boot-prompt">$</span> whoami</p>
      <p class="boot-line" style="--i: 2">matheesan — engineer, dj, gamer</p>
      <p class="boot-line" style="--i: 3"><span class="boot-prompt">$</span> cat focus.txt</p>
      <p class="boot-line" style="--i: 4">music · games · ai systems</p>
      <p class="boot-line boot-ok" style="--i: 5">[ok] signal acquired</p>
    </div>
    <div class="boot-foot mono">
      <span>click or press esc to skip</span>
      <span>43.8561° N / 79.3370° W</span>
    </div>
  </div>
</div>

<style>
  body.boot-open { overflow: hidden; }

  .boot {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background:
      radial-gradient(ellipse 55% 55% at 78% 20%, rgba(40, 82, 130, 0.3), transparent 70%),
      radial-gradient(ellipse 45% 45% at 12% 85%, rgba(27, 58, 92, 0.25), transparent 70%),
      #05080e;
    cursor: pointer;
    transition: opacity 0.55s ease, visibility 0.55s ease;
  }

  .boot[hidden] { display: none; }

  .boot::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.018) 0,
      rgba(255, 255, 255, 0.018) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    opacity: 0.45;
  }

  .boot--done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .boot-moon {
    position: absolute;
    top: 12%;
    right: 9%;
    width: min(22vw, 260px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 34%, #eef4ff 0%, #b8cee9 28%, #6f96c2 58%, #1a2a4a 100%);
    opacity: 0.3;
    box-shadow: 0 0 80px 30px rgba(127, 168, 212, 0.08);
  }

  .boot-moon::after {
    content: '';
    position: absolute;
    inset: -18px;
    border: 1px solid rgba(127, 168, 212, 0.1);
    border-radius: 50%;
  }

  .boot-glow {
    position: absolute;
    width: min(70vw, 620px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(127, 168, 212, 0.16), transparent 65%);
    filter: blur(10px);
    animation: bootGlow 2.4s ease-in-out infinite;
  }

  .boot-terminal {
    position: relative;
    width: min(570px, calc(100vw - 2rem));
    border: 1px solid rgba(88, 174, 201, 0.28);
    background: rgba(5, 10, 18, 0.94);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    animation: bootIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .boot-terminal::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    width: 44px;
    height: 1px;
    background: var(--accent);
  }

  .boot-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.54rem;
    letter-spacing: 0.08em;
    color: var(--text3);
  }

  .boot-dots { display: inline-flex; gap: 4px; }
  .boot-dots i { width: 5px; height: 5px; border-radius: 50%; display: block; }
  .boot-dots i:nth-child(1) { background: #d98080; }
  .boot-dots i:nth-child(2) { background: var(--gold); }
  .boot-dots i:nth-child(3) { background: var(--ok); }
  .boot-status { margin-left: auto; color: var(--ok); }

  .boot-body {
    padding: 1.1rem 1rem 1.2rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.85;
    color: var(--text2);
  }

  .boot-line {
    opacity: 0;
    transform: translateY(3px);
    animation: bootLine 0.3s ease forwards;
    animation-delay: calc(var(--i) * 0.22s + 0.15s);
  }

  .boot-prompt { color: var(--ok); }
  .boot-ok { color: var(--ok); }

  .boot-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    color: var(--text3);
  }

  @keyframes bootIn {
    from { opacity: 0; transform: translateY(10px) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes bootLine {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes bootGlow {
    0%, 100% { opacity: 0.55; transform: scale(0.96); }
    50% { opacity: 1; transform: scale(1.04); }
  }

  @media (max-width: 520px) {
    .boot-moon { width: 120px; top: 7%; right: 4%; opacity: 0.18; }
    .boot-body { font-size: 0.7rem; }
    .boot-foot { flex-direction: column; gap: 0.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot { display: none !important; }
  }
</style>

<script>
  const boot = document.getElementById('boot');
  if (boot) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const params = new URLSearchParams(location.search);
    const force = params.get('boot');
    let seen = false;
    try { seen = sessionStorage.getItem('boot-seen') === '1'; } catch {}

    if (reduced || force === '0' || (seen && force !== '1')) {
      boot.remove();
    } else {
      boot.hidden = false;
      document.body.classList.add('boot-open');
      try { sessionStorage.setItem('boot-seen', '1'); } catch {}

      let closed = false;
      const close = () => {
        if (closed) return;
        closed = true;
        boot.classList.add('boot--done');
        document.body.classList.remove('boot-open');
        window.setTimeout(() => boot.remove(), 600);
      };

      const status = boot.querySelector('.boot-status');
      window.setTimeout(() => { if (status) status.textContent = 'online'; }, 1200);

      const timer = window.setTimeout(close, 2200);
      const skip = () => { window.clearTimeout(timer); close(); };

      boot.addEventListener('click', skip);
      const onKey = (e: KeyboardEvent) => {
        if (e.key !== 'Escape') return;
        skip();
        document.removeEventListener('keydown', onKey);
      };
      document.addEventListener('keydown', onKey);
    }
  }
</script>
