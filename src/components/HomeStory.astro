---
import { chapters } from '../data/story';
import Depth from './Depth.astro';

const story = chapters.filter((chapter) => ['name', 'work', 'booth'].includes(chapter.id));
const glyphs: Record<string, string> = { name: '月', work: '工', booth: '音' };
---

<section id="story" class="story" aria-labelledby="story-title">
  <div class="container">
    <div class="story-grid">
      <header class="story-head fade-up">
        <p class="section-label">// the story</p>
        <h2 id="story-title" class="section-title">A few true things, <em>in order.</em></h2>
        <p class="story-deck">
          The short version of who I am and how I got here. Each piece has a little more underneath
          if you want it — and full pages if you want all of it.
        </p>

        <nav class="story-index" aria-label="In this section">
          <p class="mono">// in this section</p>
          {story.map((chapter) => (
            <a href={`#${chapter.id}`}>
              <span class="story-index-num mono">{chapter.num}</span>
              <span class="story-index-label">{chapter.label}</span>
              <span class="story-index-glyph" aria-hidden="true" lang="ja">{glyphs[chapter.id]}</span>
            </a>
          ))}
          <a class="story-index-more" href="/about/">
            the whole story <span aria-hidden="true">→</span>
          </a>
        </nav>
      </header>

      <div class="story-chapters">
        {story.map((chapter) => (
          <article class="story-chapter fade-up" id={chapter.id}>
            <div class="story-chapter-top">
              <p class="story-chapter-num mono">{chapter.num} / {chapter.label}</p>
              <span class="story-chapter-glyph" aria-hidden="true" lang="ja">{glyphs[chapter.id]}</span>
            </div>

            <h3 class="story-chapter-title">{chapter.title}</h3>

            {chapter.lead.map((paragraph) => <p class="story-chapter-lead">{paragraph}</p>)}

            {chapter.deeper && (
              <Depth
                label={chapter.deeper.label}
                note={`${chapter.deeper.body.length} more ${chapter.deeper.body.length === 1 ? 'paragraph' : 'paragraphs'}`}
              >
                {chapter.deeper.body.map((paragraph) => <p>{paragraph}</p>)}
                {chapter.link && (
                  <a class="story-chapter-link mono" href={chapter.link.href}>
                    {chapter.link.label} <span aria-hidden="true">→</span>
                  </a>
                )}
              </Depth>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    padding: 6rem 0 5.5rem;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .story::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 30% 40%, #000 0%, transparent 78%);
    mask-image: radial-gradient(ellipse 60% 70% at 30% 40%, #000 0%, transparent 78%);
    opacity: 0.5;
    pointer-events: none;
  }

  .story-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 4.5rem;
    align-items: start;
  }

  .story-head { position: sticky; top: 7rem; }

  .story-head .section-title { margin-bottom: 1.2rem; }

  .story-deck {
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--text2);
    max-width: 46ch;
  }

  .story-index {
    display: flex;
    flex-direction: column;
    margin-top: 2.4rem;
    border-top: 1px solid var(--line);
  }

  .story-index > p {
    font-size: 0.54rem;
    letter-spacing: 0.14em;
    color: var(--text3);
    padding: 0.9rem 0 0.5rem;
  }

  .story-index a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.55rem 0;
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--text2);
    text-decoration: none;
    border-bottom: 1px solid rgba(28, 47, 73, 0.55);
    transition: color 0.2s, padding-left 0.2s;
  }

  .story-index a:hover { color: var(--moon); padding-left: 0.35rem; }

  .story-index-num { font-size: 0.52rem; color: var(--accent); }

  .story-index-label { flex: 1; }

  .story-index-glyph {
    font-family: var(--jp);
    font-size: 0.9rem;
    color: var(--wave2);
    transition: color 0.2s;
  }

  .story-index a:hover .story-index-glyph { color: var(--accent); }

  .story-index .story-index-more {
    margin-top: 0.5rem;
    border-bottom: 0;
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    padding-top: 0.8rem;
  }

  .story-index .story-index-more:hover { color: var(--accent2); }

  .story-chapters { display: flex; flex-direction: column; gap: 2.6rem; }

  .story-chapter {
    position: relative;
    padding: 0 0 2.4rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6.5rem;
  }

  .story-chapter:last-child { border-bottom: 0; padding-bottom: 0; }

  .story-chapter::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1.2rem;
    width: 10px;
    height: 10px;
    border-top: 1px solid var(--wave2);
    border-left: 1px solid var(--wave2);
    opacity: 0.7;
  }

  .story-chapter-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .story-chapter-num {
    font-size: 0.58rem;
    letter-spacing: 0.13em;
    color: var(--accent);
    text-transform: lowercase;
  }

  .story-chapter-glyph {
    font-family: var(--jp);
    font-size: 1.1rem;
    color: var(--wave2);
    opacity: 0.75;
    line-height: 1;
  }

  .story-chapter-title {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--text1);
    margin-bottom: 0.8rem;
  }

  .story-chapter-lead {
    font-family: var(--serif);
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--text2);
    max-width: 62ch;
  }

  .story-chapter-link {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 0.9rem;
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--wave2);
    padding-bottom: 0.12rem;
  }

  .story-chapter-link:hover { color: var(--accent2); }

  @media (max-width: 980px) {
    .story-grid { grid-template-columns: 1fr; gap: 2.4rem; }
    .story-head { position: static; }
  }

  @media (max-width: 720px) {
    .story { padding: 4rem 0 3.6rem; }
    .story-chapter { padding-bottom: 1.9rem; }
    .story-chapter::before { left: -0.7rem; }
  }
</style>
